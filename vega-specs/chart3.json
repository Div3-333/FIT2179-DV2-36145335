{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "The Atmospheric Engine",
    "subtitle": "Correlation: Southern Oscillation Index (Line) vs. Rainfall (Bars)",
    "anchor": "start",
    "color": "#2C3E50",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#5D6D7E",
    "offset": 20
  },
  "layer": [
    {
      "data": {
        "url": "data/final/chart3_caulfield_rain.csv"
      },
      "transform": [
        {
          "calculate": "{'Jan':0,'Feb':1,'Mar':2,'Apr':3,'May':4,'Jun':5,'Jul':6,'Aug':7,'Sep':8,'Oct':9,'Nov':10,'Dec':11}[datum.Month]",
          "as": "MonthNum"
        },
        {"calculate": "datetime(datum.Year, datum.MonthNum, 1)", "as": "Date"},
        {"filter": "datum.Year >= 2010"}
      ],
      "mark": {"type": "bar", "color": "#94C1EA", "opacity": 0.6, "width": {"band": 0.8}},
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "title": "Year",
          "axis": {"grid": false}
        },
        "y": {
          "field": "Rainfall_mm",
          "type": "quantitative",
          "title": "Monthly Rainfall (mm)",
          "axis": {"titleColor": "#3498DB"}
        },
        "tooltip": [
          {"field": "Date", "type": "temporal", "title": "Month", "format": "%b %Y"},
          {"field": "Rainfall_mm", "type": "quantitative", "title": "Rainfall (mm)"}
        ]
      }
    },
    {
      "data": {
        "url": "data/final/chart3_soi_monthly.csv"
      },
      "transform": [
        {"calculate": "datetime(datum.Year, datum.Month - 1, 1)", "as": "Date"},
        {"filter": "datum.Year >= 2010"}
      ],
      "mark": {
        "type": "line",
        "color": "#E67E22",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {"field": "Date", "type": "temporal"},
        "y": {
          "field": "SOI",
          "type": "quantitative",
          "title": "Southern Oscillation Index (SOI)",
          "axis": {"orient": "right", "titleColor": "#E67E22"}
        },
        "tooltip": [
          {"field": "Date", "type": "temporal", "title": "Month", "format": "%b %Y"},
          {"field": "SOI", "type": "quantitative", "title": "SOI Value"}
        ]
      }
    }
  ],
  "resolve": {"scale": {"y": "independent"}},
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#2C3E50",
      "labelFont": "Source Sans Pro",
      "titleFont": "Source Sans Pro"
    }
  }
}
