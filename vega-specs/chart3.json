{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "The Atmospheric Engine",
    "subtitle": "Correlation: Southern Oscillation Index (Line) vs. Rainfall (Bars) | 2004 - 2019",
    "anchor": "start",
    "color": "#2C3E50",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#5D6D7E",
    "offset": 20
  },
  "layer": [
    {
      "layer": [
        {
          "data": {
            "url": "data/final/chart3_caulfield_rain.csv"
          },
          "transform": [
            {
              "calculate": "{'Jan':0,'Feb':1,'Mar':2,'Apr':3,'May':4,'Jun':5,'Jul':6,'Aug':7,'Sep':8,'Oct':9,'Nov':10,'Dec':11}[datum.Month]",
              "as": "MonthNum"
            },
            {
              "calculate": "datetime(datum.Year, datum.MonthNum, 1)",
              "as": "Date"
            },
            {
              "filter": "datum.Year >= 2004 && datum.Year <= 2019"
            }
          ],
          "mark": {
            "type": "bar",
            "color": "#94C1EA",
            "opacity": 0.6,
            "width": 4
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal",
              "title": "Year",
              "axis": {
                "grid": false
              }
            },
            "y": {
              "field": "Rainfall_mm",
              "type": "quantitative",
              "title": "Monthly Rainfall (mm)",
              "axis": {
                "titleColor": "#3498DB"
              }
            },
            "tooltip": [
              {
                "field": "Date",
                "type": "temporal",
                "title": "Month",
                "format": "%b %Y"
              },
              {
                "field": "Rainfall_mm",
                "type": "quantitative",
                "title": "Rainfall (mm)"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "Date": "2018-05-01",
                "Rainfall_mm": 0,
                "Date2": "2016-08-01",
                "Rainfall_mm2": 170
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#1F6FA8",
            "strokeWidth": 2,
            "opacity": 0.85
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal",
              "axis": null
            },
            "y": {
              "field": "Rainfall_mm",
              "type": "quantitative",
              "axis": null
            },
            "x2": {
              "field": "Date2"
            },
            "y2": {
              "field": "Rainfall_mm2"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "Date": "2016-08-01",
                "Rainfall_mm": 170,
                "text": "2018 dry months|local rainfall collapse"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#1F6FA8",
            "lineBreak": "|"
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal",
              "axis": null
            },
            "y": {
              "field": "Rainfall_mm",
              "type": "quantitative",
              "axis": null
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    },
    {
      "layer": [
        {
          "data": {
            "url": "data/final/chart3_soi_monthly.csv"
          },
          "transform": [
            {
              "calculate": "datetime(datum.Year, datum.Month - 1, 1)",
              "as": "Date"
            },
            {
              "filter": "datum.Year >= 2004 && datum.Year <= 2019"
            }
          ],
          "mark": {
            "type": "line",
            "color": "#E67E22",
            "strokeWidth": 2,
            "interpolate": "monotone"
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal",
              "axis": null
            },
            "y": {
              "field": "SOI",
              "type": "quantitative",
              "title": "Southern Oscillation Index (SOI)",
              "axis": {
                "orient": "right",
                "titleColor": "#E67E22"
              }
            },
            "tooltip": [
              {
                "field": "Date",
                "type": "temporal",
                "title": "Month",
                "format": "%b %Y"
              },
              {
                "field": "SOI",
                "type": "quantitative",
                "title": "SOI Value"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "Date": "2015-10-01",
                "SOI": -20.2,
                "Date2": "2013-08-01",
                "SOI2": 23
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#E67E22",
            "strokeWidth": 2,
            "opacity": 0.85
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal",
              "axis": null
            },
            "y": {
              "field": "SOI",
              "type": "quantitative",
              "axis": null
            },
            "x2": {
              "field": "Date2"
            },
            "y2": {
              "field": "SOI2"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "Date": "2013-08-01",
                "SOI": 23,
                "text": "2015 El Nino|SOI trough"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#A64F00",
            "lineBreak": "|"
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal",
              "axis": null
            },
            "y": {
              "field": "SOI",
              "type": "quantitative",
              "axis": null
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domainColor": "#2C3E50",
      "labelFont": "Source Sans Pro",
      "titleFont": "Source Sans Pro"
    }
  }
}
