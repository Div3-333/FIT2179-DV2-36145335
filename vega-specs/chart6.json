{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "The Reservoir Network",
    "subtitle": "Current Capacity (%) and Total Volume (ML) across Major Victorian Dams",
    "anchor": "start",
    "color": "#E0F2FE",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#A9CCE3",
    "offset": 20
  },
  "projection": {
    "type": "mercator",
    "center": [146.0, -37.8],
    "scale": 12000
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "rgba(255,255,255,0.05)",
        "stroke": "rgba(255,255,255,0.1)",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/final/chart6_dam_locations.csv"
      },
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.9,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "size": {
          "field": "Capacity_ML",
          "type": "quantitative",
          "scale": {"range": [100, 4000]},
          "legend": {"title": "Capacity (ML)", "labelColor": "#E0F2FE", "titleColor": "#E0F2FE", "format": ".0s"}
        },
        "color": {
          "field": "Percent_Full",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [40, 70, 100],
            "range": ["#3B0F70", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {"title": "% Full", "labelColor": "#E0F2FE", "titleColor": "#E0F2FE"}
        },
        "tooltip": [
          {"field": "Reservoir", "type": "nominal"},
          {"field": "Percent_Full", "type": "quantitative", "title": "% Full", "format": ".1f"},
          {"field": "Capacity_ML", "type": "quantitative", "title": "Max Capacity (ML)", "format": ","}
        ]
      }
    },
    {
      "data": {
        "url": "data/final/chart6_dam_locations.csv"
      },
      "mark": {
        "type": "text",
        "dy": -25,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#E0F2FE"
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "text": {"field": "Reservoir", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
