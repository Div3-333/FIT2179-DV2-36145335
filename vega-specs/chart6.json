{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 550,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "title": {
    "text": "The Reservoir Network",
    "subtitle": "Current Capacity (%) and Infrastructure Magnitude (ML) | Victoria",
    "anchor": "start",
    "color": "#E0F2FE",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#A9CCE3",
    "offset": 25
  },
  "projection": {
    "type": "mercator",
    "center": [
      145.7,
      -37.85
    ],
    "scale": 16000
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "rgba(255,255,255,0.03)",
        "stroke": "rgba(255,255,255,0.1)",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/final/chart6_dam_locations.csv"
      },
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Capacity_ML",
          "type": "quantitative",
          "scale": {
            "range": [
              200,
              5000
            ]
          },
          "legend": {
            "title": "Capacity (ML)",
            "labelColor": "#E0F2FE",
            "titleColor": "#E0F2FE",
            "format": ".1s",
            "orient": "none",
            "legendX": 550,
            "legendY": 230,
            "symbolFillColor": "rgba(255,255,255,0.2)"
          }
        },
        "color": {
          "field": "Percent_Full",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              65,
              80,
              100
            ],
            "range": [
              "#3B0F70",
              "#FE9F6D",
              "#FCFDBF"
            ]
          },
          "legend": {
            "title": "% Full",
            "labelColor": "#E0F2FE",
            "titleColor": "#E0F2FE",
            "orient": "none",
            "legendX": 10,
            "legendY": 10
          }
        },
        "tooltip": [
          {
            "field": "Reservoir",
            "type": "nominal"
          },
          {
            "field": "Percent_Full",
            "type": "quantitative",
            "title": "Current Status (%)",
            "format": ".1f"
          },
          {
            "field": "Capacity_ML",
            "type": "quantitative",
            "title": "Max Volume (ML)",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/final/chart6_dam_locations.csv"
      },
      "mark": {
        "type": "text",
        "dy": -25,
        "fontSize": 11,
        "color": "#00E5FF"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Reservoir",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 146.392,
            "lat": -37.766,
            "lon2": 146.08,
            "lat2": -37.54
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#E0F2FE",
        "strokeWidth": 2,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 146.08,
            "lat": -37.54,
            "text": "Thomson|largest capacity"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 18,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#E0F2FE",
        "lineBreak": "|"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 145.13,
            "lat": -37.55,
            "lon2": 144.88,
            "lat2": -37.42
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#FCFDBF",
        "strokeWidth": 2,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 144.88,
            "lat": -37.42,
            "text": "Yan Yean|lowest % full"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -16,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#FCFDBF",
        "lineBreak": "|"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "font": "Source Sans Pro"
  }
}
