{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "The Reservoir Network",
    "subtitle": "Current Capacity (%) and Infrastructure Magnitude (ML) | Victoria",
    "anchor": "start",
    "color": "#E0F2FE",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#A9CCE3",
    "offset": 25
  },
  "projection": {
    "type": "mercator",
    "center": [146.1, -37.85],
    "scale": 15000
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "rgba(255,255,255,0.03)",
        "stroke": "rgba(255,255,255,0.08)",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {"url": "data/final/chart6_dam_locations.csv"},
      "mark": {
        "type": "circle",
        "opacity": 0.2,
        "color": "#FCFDBF"
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "size": {
          "field": "Capacity_ML",
          "type": "quantitative",
          "scale": {"range": [500, 8000]},
          "legend": null
        }
      }
    },
    {
      "data": {"url": "data/final/chart6_dam_locations.csv"},
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.9,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "size": {
          "field": "Capacity_ML",
          "type": "quantitative",
          "scale": {"range": [100, 3500]},
          "legend": {
            "title": "Total Capacity (ML)", 
            "labelColor": "#E0F2FE", 
            "titleColor": "#E0F2FE", 
            "format": ".2s",
            "orient": "bottom-left",
            "offset": 10
          }
        },
        "color": {
          "field": "Percent_Full",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [40, 70, 100],
            "range": ["#3B0F70", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {
            "title": "% Full", 
            "labelColor": "#E0F2FE", 
            "titleColor": "#E0F2FE",
            "orient": "bottom-right",
            "offset": 10
          }
        },
        "tooltip": [
          {"field": "Reservoir", "type": "nominal"},
          {"field": "Percent_Full", "type": "quantitative", "title": "Current Status (%)", "format": ".1f"},
          {"field": "Capacity_ML", "type": "quantitative", "title": "Max Volume (ML)", "format": ","}
        ]
      }
    },
    {
      "data": {"url": "data/final/chart6_dam_locations.csv"},
      "transform": [{"filter": "datum.Capacity_ML > 50000"}],
      "mark": {
        "type": "text",
        "dy": -28,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "white",
        "font": "Merriweather"
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "text": {"field": "Reservoir", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
