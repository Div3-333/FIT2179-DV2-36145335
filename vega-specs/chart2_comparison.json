        {
          "filter": "isValid(datum['Comparison decade']) && isValid(datum['Reference decade'])"
        },
        {
          "calculate": "datum['Comparison decade'] - datum['Reference decade']",
          "as": "Delta"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "Delta",
              "as": "MaxDelta"
            },
            {
              "op": "min",
              "field": "Delta",
              "as": "MinDelta"
            }
          ]
        },
        {
          "calculate": "['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][datum.MonthNum]",
          "as": "MonthLabel"
        },
        {
          "calculate": "datum.Delta >= 0 ? '+' + format(datum.Delta, '.1f') : format(datum.Delta, '.1f')",
          "as": "DeltaText"
        },
        {
          "filter": "datum.Delta == datum.MinDelta"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "GapRank"
            }
          ],
          "sort": [
            {
              "field": "MonthNum",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.GapRank == 1"
        },
        {
          "calculate": "'Smallest gap|' + datum.MonthLabel + ' ' + datum.DeltaText + ' deg C'",
          "as": "Annotation"
        },
        {
          "calculate": "7.65",
          "as": "LabelX"
        },
        {
          "calculate": "13.55",
          "as": "LabelY"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#263B4E",
        "lineBreak": "|"
      },
      "encoding": {
        "x": {
