{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Arid Shift: Victorian Rainfall Deficit",
    "subtitle": "Rainfall lost (mm) across key Victorian hubs in the last 12 months",
    "anchor": "start",
    "color": "#ffffff",
    "subtitleColor": "#94C1EA"
  },
  "width": "container",
  "height": 500,
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/vic_lga.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "rgba(255,255,255,0.05)",
        "stroke": "rgba(255,255,255,0.2)",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/final/chart1_vic_rainfall_deficit.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "size": {
          "field": "Rainfall_Deficit_mm",
          "type": "quantitative",
          "scale": {"range": [100, 2000]},
          "legend": {"title": "Deficit (mm)", "orient": "bottom-right"}
        },
        "color": {
          "field": "Rainfall_Deficit_mm",
          "type": "quantitative",
          "scale": {"scheme": "magma", "reverse": true},
          "legend": null
        },
        "tooltip": [
          {"field": "LGA", "type": "nominal", "title": "Region"},
          {"field": "Rainfall_Deficit_mm", "type": "quantitative", "title": "Deficit (mm)"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#ffffff", "tickColor": "#ffffff",
      "labelColor": "#ffffff", "titleColor": "#ffffff",
      "gridColor": "rgba(255,255,255,0.1)",
      "titleFont": "Source Sans Pro", "labelFont": "Source Sans Pro"
    },
    "legend": {"labelColor": "#ffffff", "titleColor": "#ffffff"}
  }
}
