{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Arid Shift: Victorian Rainfall Deficit",
    "subtitle": "Rainfall lost (mm) across Victoria over the last 12 months",
    "anchor": "start",
    "color": "#2C3E50",
    "subtitleColor": "#5D6D7E",
    "fontSize": 24,
    "subtitleFontSize": 16,
    "subtitlePadding": 10,
    "offset": 20
  },
  "width": "container",
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 10, "top": 10, "right": 10, "bottom": 10},
  "data": {
    "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "lookup": "properties.vic_loca_2",
      "from": {
        "data": {
          "url": "data/final/chart1_vic_rainfall_deficit.csv"
        },
        "key": "LGA",
        "fields": ["Rainfall_Deficit_mm"]
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "rgba(255,255,255,0.4)",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "field": "Rainfall_Deficit_mm",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [40, 120, 220],
            "range": ["#FAD7A0", "#E67E22", "#512E5F"]
          },
          "legend": {
            "title": "Deficit (mm)",
            "orient": "right",
            "direction": "vertical",
            "gradientLength": 300,
            "titleColor": "#2C3E50",
            "labelColor": "#2C3E50",
            "titleFontSize": 12,
            "labelFontSize": 10,
            "offset": 20
          }
        },
        "tooltip": [
          {"field": "properties.vic_loca_2", "type": "nominal", "title": "Suburb"},
          {"field": "Rainfall_Deficit_mm", "type": "quantitative", "title": "Deficit (mm)"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
