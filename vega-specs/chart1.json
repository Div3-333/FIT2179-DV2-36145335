{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Arid Shift: Victorian Rainfall Deficit",
    "subtitle": "Percentage of average rainfall lost in the last 12 months",
    "anchor": "start",
    "color": "#ffffff",
    "subtitleColor": "#94C1EA"
  },
  "width": "container",
  "height": 500,
  "data": {
    "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/vic_lga.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "lookup": "properties.LGA_NAME",
      "from": {
        "data": {
          "url": "data/final/chart1_vic_rainfall_deficit.csv"
        },
        "key": "LGA",
        "fields": ["Rainfall_Deficit_mm"]
      }
    },
    {"calculate": "datum.Rainfall_Deficit_mm ? datum.Rainfall_Deficit_mm : 40", "as": "Deficit"}
  ],
  "projection": {"type": "mercator"},
  "mark": {
    "type": "geoshape", 
    "stroke": "#2c3e50", 
    "strokeWidth": 0.5
  },
  "encoding": {
    "color": {
      "field": "Deficit",
      "type": "quantitative",
      "scale": {
        "type": "linear",
        "domain": [0, 250],
        "range": ["#FAD7A0", "#E67E22", "#A93226"]
      },
      "legend": {
        "title": "Deficit (mm)",
        "orient": "bottom-right",
        "direction": "vertical",
        "gradientLength": 200
      }
    },
    "tooltip": [
      {"field": "properties.LGA_NAME", "type": "nominal", "title": "LGA"},
      {"field": "Deficit", "type": "quantitative", "title": "Deficit (mm)"}
    ]
  },
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#ffffff", "tickColor": "#ffffff",
      "labelColor": "#ffffff", "titleColor": "#ffffff",
      "gridColor": "rgba(255,255,255,0.1)",
      "titleFont": "Source Sans Pro", "labelFont": "Source Sans Pro"
    },
    "legend": {"labelColor": "#ffffff", "titleColor": "#ffffff", "titleFontSize": 12}
  }
}
