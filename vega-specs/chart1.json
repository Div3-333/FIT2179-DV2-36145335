{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 480,
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 0, "top": 0, "right": 0, "bottom": 0},
  "title": {
    "text": "The Arid Shift: Victorian Rainfall Deficit",
    "subtitle": "Rainfall lost (mm) across Victoria over the last 12 months",
    "anchor": "start",
    "color": "#2C3E50",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#5D6D7E",
    "offset": 25
  },
  "data": {
    "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "lookup": "properties.vic_loca_2",
      "from": {
        "data": {
          "url": "data/final/chart1_vic_rainfall_deficit.csv"
        },
        "key": "LGA",
        "fields": ["Rainfall_Deficit_mm"]
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [145.2, -36.6],
    "scale": 3800
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "rgba(255,255,255,0.4)",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "field": "Rainfall_Deficit_mm",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [40, 100, 160, 220],
            "range": ["#3B0F70", "#8C2981", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {
            "title": "Rainfall Deficit (mm)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": {"signal": "width * 0.6"},
            "titleColor": "#2C3E50",
            "labelColor": "#2C3E50",
            "titleFontSize": 12,
            "labelFontSize": 10,
            "offset": 50
          }
        },
        "tooltip": [
          {"field": "properties.vic_loca_2", "type": "nominal", "title": "Suburb"},
          {"field": "Rainfall_Deficit_mm", "type": "quantitative", "title": "Deficit (mm)"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
