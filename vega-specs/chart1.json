{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Arid Shift: Victorian Rainfall Deficit",
    "subtitle": "Rainfall lost (mm) across key Victorian hubs in the last 12 months",
    "anchor": "start",
    "color": "#2C3E50",
    "subtitleColor": "#5D6D7E",
    "fontSize": 24,
    "subtitleFontSize": 16,
    "subtitlePadding": 10
  },
  "width": "container",
  "height": 500,
  "data": {
    "url": "data/final/chart1_vic_rainfall_deficit.csv"
  },
  "projection": {
    "type": "mercator",
    "center": [145, -36.5],
    "scale": 3800
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.4,
        "color": "#BDC3C7",
        "size": 4000
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 0.9,
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "size": {
          "field": "Rainfall_Deficit_mm",
          "type": "quantitative",
          "scale": {"range": [400, 4000]},
          "legend": {
            "title": "Deficit (mm)",
            "orient": "bottom-right",
            "titleColor": "#2C3E50",
            "labelColor": "#2C3E50"
          }
        },
        "color": {
          "field": "Rainfall_Deficit_mm",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [0, 250],
            "range": ["#FAD7A0", "#E67E22", "#A93226"]
          },
          "legend": {
            "title": "Severity",
            "titleColor": "#2C3E50",
            "labelColor": "#2C3E50"
          }
        },
        "tooltip": [
          {"field": "LGA", "type": "nominal", "title": "Region"},
          {"field": "Rainfall_Deficit_mm", "type": "quantitative", "title": "Rainfall Deficit (mm)"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -25,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#2C3E50"
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "text": {"field": "LGA", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
