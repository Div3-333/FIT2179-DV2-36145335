{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "Subterranean Stress Field",
    "subtitle": "High-Resolution Extraction Intensity (0.1° Grid) | Victoria",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 24,
    "subtitleFontSize": 14,
    "subtitleColor": "#B0BEC5",
    "offset": 25
  },
  "projection": {
    "type": "mercator",
    "center": [144.5, -36.5],
    "scale": 4000
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#3B0F70",
        "stroke": "rgba(255,255,255,0.1)",
        "strokeWidth": 0.5,
        "opacity": 0.4
      }
    },
    {
      "data": {
        "url": "data/final/chart7_hd_grid.csv"
      },
      "mark": {
        "type": "rect",
        "opacity": 1,
        "cornerRadius": 1
      },
      "encoding": {
        "longitude": {"field": "lon1", "type": "quantitative"},
        "latitude": {"field": "lat1", "type": "quantitative"},
        "longitude2": {"field": "lon2"},
        "latitude2": {"field": "lat2"},
        "color": {
          "field": "StressLevel",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [0, 2, 8, 15],
            "range": ["#3B0F70", "#8C2981", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {
            "title": "Bore Permits", 
            "labelColor": "#D7CCC8", 
            "titleColor": "#D7CCC8",
            "orient": "right",
            "gradientLength": 250,
            "values": [0, 5, 10, 15]
          }
        },
        "tooltip": [
          {"field": "StressLevel", "type": "quantitative", "title": "Bore Permits in Area"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
