{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "Subterranean Stress Field",
    "subtitle": "Quantified Groundwater Extraction: Permits per 20km² | Victoria",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 25
  },
  "projection": {
    "type": "mercator",
    "center": [145.4, -36.5],
    "scale": 4200
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "rgba(45, 36, 30, 0.4)",
        "stroke": "rgba(255,255,255,0.05)",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/final/chart7_spatial_grid.csv"
      },
      "mark": {
        "type": "rect",
        "opacity": 0.8,
        "cornerRadius": 2
      },
      "encoding": {
        "longitude": {"field": "lon1", "type": "quantitative"},
        "latitude": {"field": "lat1", "type": "quantitative"},
        "longitude2": {"field": "lon2"},
        "latitude2": {"field": "lat2"},
        "color": {
          "field": "PermitCount",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [1, 5, 10, 20],
            "range": ["#3B0F70", "#8C2981", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {
            "title": "Permits in Area", 
            "labelColor": "#D7CCC8", 
            "titleColor": "#D7CCC8",
            "orient": "right",
            "gradientLength": 300
          }
        },
        "tooltip": [
          {"field": "PermitCount", "type": "quantitative", "title": "Bore Permits in Area"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
