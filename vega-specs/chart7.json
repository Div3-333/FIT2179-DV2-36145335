{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "Subterranean Stress",
    "subtitle": "Groundwater Extraction Density by Suburb (Active Bore Permits) | Victoria",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 20
  },
  "data": {
    "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "lookup": "properties.vic_loca_2",
      "from": {
        "data": {
          "url": "data/final/chart7_suburb_density.csv"
        },
        "key": "Suburb",
        "fields": ["BoreCount", "Intensity"]
      }
    },
    {"calculate": "datum.BoreCount ? datum.BoreCount : 0", "as": "Count"}
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "rgba(255,255,255,0.05)",
        "strokeWidth": 0.2
      },
      "encoding": {
        "color": {
          "field": "Count",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [0, 1, 3, 8],
            "range": ["#3B0F70", "#8C2981", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {
            "title": "Bore Permits", 
            "labelColor": "#D7CCC8", 
            "titleColor": "#D7CCC8",
            "orient": "right",
            "gradientLength": 300
          }
        },
        "tooltip": [
          {"field": "properties.vic_loca_2", "type": "nominal", "title": "Suburb"},
          {"field": "Count", "type": "quantitative", "title": "Permits"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
