{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "Subterranean Stress",
    "subtitle": "Active Bore Permits: Visualizing Extraction Intensity Clusters | Victoria",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 25
  },
  "projection": {
    "type": "mercator",
    "center": [144.5, -36.5],
    "scale": 4200
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "rgba(45, 36, 30, 0.4)",
        "stroke": "rgba(255,255,255,0.05)",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/final/chart7_starfield_data.csv"
      },
      "mark": {
        "type": "circle",
        "filled": true,
        "stroke": "white",
        "strokeWidth": 0.2
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "size": {
          "field": "LocalDensity",
          "type": "quantitative",
          "scale": {"range": [10, 400]},
          "legend": {
            "title": "Extraction Density", 
            "labelColor": "#D7CCC8", 
            "titleColor": "#D7CCC8",
            "orient": "right"
          }
        },
        "color": {
          "field": "LocalDensity",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [1, 5, 20],
            "range": ["#3B0F70", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {
            "title": "Local Stress", 
            "labelColor": "#D7CCC8", 
            "titleColor": "#D7CCC8",
            "orient": "right",
            "gradientLength": 250
          }
        },
        "opacity": {
          "field": "LocalDensity",
          "type": "quantitative",
          "scale": {"domain": [1, 20], "range": [0.4, 1]},
          "legend": null
        },
        "tooltip": [
          {"field": "LocalDensity", "type": "quantitative", "title": "Permits in Radius"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
