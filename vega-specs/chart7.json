{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "Subterranean Stress",
    "subtitle": "Heatmap of Active Bore Permits (Groundwater Extraction) | Victoria",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 20
  },
  "data": {
    "url": "data/final/chart7_hexbin_data.csv"
  },
  "projection": {
    "type": "mercator",
    "center": [144.5, -36.5],
    "scale": 4500
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "rgba(255,255,255,0.02)",
        "stroke": "rgba(255,255,255,0.1)",
        "strokeWidth": 0.5
      }
    },
    {
      "mark": {
        "type": "point",
        "shape": "hexagon",
        "filled": true,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {"field": "Lon", "type": "quantitative"},
        "latitude": {"field": "Lat", "type": "quantitative"},
        "size": {
          "field": "PermitCount",
          "type": "quantitative",
          "scale": {"range": [200, 1500]},
          "legend": {"title": "Extraction Depth", "labelColor": "#D7CCC8", "titleColor": "#D7CCC8"}
        },
        "color": {
          "field": "Intensity",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [1, 5, 20],
            "range": ["#3B0F70", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {"title": "Pressure Level", "labelColor": "#D7CCC8", "titleColor": "#D7CCC8"}
        },
        "tooltip": [
          {"field": "PermitCount", "type": "quantitative", "title": "Bore Permits"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
