{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "Subterranean Stress Field",
    "subtitle": "High-Resolution Extraction Intensity (KDE Model) | Victoria",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 25
  },
  "projection": {
    "type": "mercator",
    "center": [144.5, -36.5],
    "scale": 4500
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "rgba(255,255,255,0.02)",
        "stroke": "rgba(255,255,255,0.1)",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/final/chart7_highres_density.csv"
      },
      "mark": {
        "type": "rect",
        "width": 18,
        "height": 18,
        "opacity": 0.7,
        "blur": 10
      },
      "encoding": {
        "longitude": {"field": "Lon", "type": "quantitative"},
        "latitude": {"field": "Lat", "type": "quantitative"},
        "color": {
          "field": "Intensity",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [0.1, 0.4, 0.8, 1],
            "range": ["#3B0F70", "#8C2981", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {
            "title": "Extraction Stress", 
            "labelColor": "#D7CCC8", 
            "titleColor": "#D7CCC8",
            "orient": "right",
            "gradientLength": 300,
            "values": [0, 1],
            "labelExpr": "datum.label == 0 ? 'Low' : 'Critical'"
          }
        },
        "tooltip": [
          {"field": "Intensity", "type": "quantitative", "title": "Stress Level", "format": ".1%"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
