{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "Subterranean Stress Field",
    "subtitle": "Thermal Density of Active Bore Permits | Victoria",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 25
  },
  "projection": {
    "type": "mercator",
    "center": [144.5, -36.5],
    "scale": 4500
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "rgba(45, 36, 30, 0.4)",
        "stroke": "rgba(255,255,255,0.05)",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/final/chart7_symbol_density.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.3,
        "blur": 15
      },
      "encoding": {
        "longitude": {"field": "Lon", "type": "quantitative"},
        "latitude": {"field": "Lat", "type": "quantitative"},
        "size": {
          "field": "BoreCount",
          "type": "quantitative",
          "scale": {"range": [400, 3000]},
          "legend": null
        },
        "color": {
          "field": "BoreCount",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [1, 5, 12],
            "range": ["#3B0F70", "#FE9F6D", "#FCFDBF"]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "data/final/chart7_symbol_density.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.6,
        "blur": 5
      },
      "encoding": {
        "longitude": {"field": "Lon", "type": "quantitative"},
        "latitude": {"field": "Lat", "type": "quantitative"},
        "size": {
          "field": "BoreCount",
          "type": "quantitative",
          "scale": {"range": [100, 1500]},
          "legend": {
            "title": "Local Density", 
            "labelColor": "#D7CCC8", 
            "titleColor": "#D7CCC8",
            "orient": "right",
            "offset": 20
          }
        },
        "color": {
          "field": "BoreCount",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [1, 5, 12],
            "range": ["#3B0F70", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {
            "title": "Permits per Hub", 
            "labelColor": "#D7CCC8", 
            "titleColor": "#D7CCC8",
            "orient": "right",
            "gradientLength": 300,
            "values": [1, 5, 10, 15],
            "offset": 20
          }
        },
        "tooltip": [
          {"field": "Suburb", "type": "nominal"},
          {"field": "BoreCount", "type": "quantitative", "title": "Bore Permits"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
