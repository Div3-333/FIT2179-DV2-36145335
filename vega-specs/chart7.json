{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "Subterranean Stress Field",
    "subtitle": "High-Resolution Extraction Intensity (0.1\u00b0 Grid) | Victoria",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 24,
    "subtitleFontSize": 14,
    "subtitleColor": "#B0BEC5",
    "offset": 25
  },
  "projection": {
    "type": "mercator",
    "center": {
      "expr": "[groundLon, groundLat]"
    },
    "scale": {
      "expr": "groundZoom"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/final/vic_suburbs_simplified.geojson?v=2",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#3B0F70",
        "stroke": "rgba(255,255,255,0.1)",
        "strokeWidth": 0.5,
        "opacity": 0.4
      }
    },
    {
      "data": {
        "url": "data/final/chart7_hd_grid.csv"
      },
      "mark": {
        "type": "rect",
        "opacity": 1,
        "cornerRadius": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon1",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat1",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        },
        "color": {
          "field": "StressLevel",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              2,
              8,
              15
            ],
            "range": [
              "#3B0F70",
              "#8C2981",
              "#FE9F6D",
              "#FCFDBF"
            ]
          },
          "legend": {
            "title": null,
            "labelColor": "#D7CCC8",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "gradientThickness": 12,
            "values": [
              0,
              5,
              10,
              15
            ]
          }
        },
        "tooltip": [
          {
            "field": "StressLevel",
            "type": "quantitative",
            "title": "Bore Permits in Area"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.StressLevel >= minBoreStress"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 145.05,
            "lat": -36.25,
            "lon2": 144.25,
            "lat2": -35.92
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#FCFDBF",
        "strokeWidth": 2,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 144.25,
            "lat": -35.92,
            "text": "Highest grid cell|27 permits"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -24,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#FCFDBF",
        "lineBreak": "|"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "background": "#241d19",
    "view": {
      "stroke": "transparent"
    },
    "font": "Source Sans Pro"
  },
  "params": [
    {
      "name": "groundZoom",
      "value": 4000
    },
    {
      "name": "groundLon",
      "value": 144.5
    },
    {
      "name": "groundLat",
      "value": -36.5
    },
    {
      "name": "minBoreStress",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 15,
        "step": 1,
        "name": "Minimum bore permits "
      }
    }
  ]
}
