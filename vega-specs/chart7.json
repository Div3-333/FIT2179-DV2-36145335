{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "Subterranean Stress",
    "subtitle": "Concentration of Active Bore Permits (Groundwater Extraction) | Victoria",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 20
  },
  "data": {
    "url": "data/final/chart7_bore_locations.csv"
  },
  "projection": {
    "type": "mercator",
    "center": [145.4, -36.5],
    "scale": 3800
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/suburb-10-vic.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "rgba(255,255,255,0.03)",
        "stroke": "rgba(255,255,255,0.1)",
        "strokeWidth": 0.5
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "bin": {"maxbins": 120},
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "bin": {"maxbins": 120},
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "aggregate": "count",
          "type": "quantitative",
          "scale": {"range": [10, 500]},
          "legend": {"title": "Bore Density", "labelColor": "#D7CCC8", "titleColor": "#D7CCC8"}
        },
        "color": {
          "aggregate": "count",
          "type": "quantitative",
          "scale": {"scheme": "magma", "domain": [1, 10]},
          "legend": {"title": "Permit Count", "labelColor": "#D7CCC8", "titleColor": "#D7CCC8"}
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
