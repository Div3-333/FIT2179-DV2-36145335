{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Unique multi-idiom visualization of the Desalination Surge",
  "width": 1100,
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "The Desalination Pulse",
    "subtitle": "Quantifying the 'Engineered Shift': Seawater Orders vs. Urban Demand (2012-2021)",
    "anchor": "start",
    "color": "#2C3E50",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#7F8C8D",
    "offset": 40
  },
  "data": {"url": "data/final/chart9_supply_dynamics.csv"},
  "vconcat": [
    {
      "width": 1100,
      "height": 220,
      "title": {
        "text": "The Supply Collision: Traditional Catchments vs. The Pulse",
        "fontSize": 14,
        "anchor": "start",
        "color": "#34495E"
      },
      "layer": [
        {
          "mark": {"type": "area", "color": "#BDC3C7", "opacity": 0.2, "interpolate": "monotone"},
          "encoding": {
            "x": {
              "field": "YearInt", 
              "type": "quantitative", 
              "scale": {"domain": [2012, 2021]},
              "axis": {"format": "d", "title": null, "grid": false}
            },
            "y": {"field": "Total_Demand_GL", "type": "quantitative", "title": "Gigalitres (GL)"},
            "tooltip": [
              {"field": "YearInt", "type": "quantitative", "title": "Year"},
              {"field": "Total_Demand_GL", "type": "quantitative", "title": "Total Demand (GL)"}
            ]
          }
        },
        {
          "mark": {"type": "area", "color": "#3498DB", "opacity": 0.8, "interpolate": "step-after"},
          "encoding": {
            "x": {"field": "YearInt", "type": "quantitative"},
            "y": {"field": "Desalination_Delivered_GL", "type": "quantitative"},
            "tooltip": [
              {"field": "YearInt", "type": "quantitative", "title": "Year"},
              {"field": "Desalination_Delivered_GL", "type": "quantitative", "title": "Desal GL"},
              {"field": "Total_Demand_GL", "type": "quantitative", "title": "Total Demand GL"}
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "dy": -10,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#2980B9"
          },
          "encoding": {
            "x": {"field": "YearInt", "type": "quantitative"},
            "y": {"field": "Desalination_Delivered_GL", "type": "quantitative"},
            "text": {
              "condition": {"test": "datum.Desalination_Delivered_GL > 0", "field": "Desalination_Delivered_GL", "type": "quantitative"},
              "value": ""
            }
          }
        }
      ]
    },
    {
      "width": 1100,
      "height": 100,
      "title": {
        "text": "The Dependency Ratio (Desalination as % of Urban Demand)",
        "fontSize": 14,
        "anchor": "start",
        "color": "#34495E"
      },
      "transform": [
        {"calculate": "datum.Desalination_Delivered_GL / datum.Total_Demand_GL", "as": "ratio"}
      ],
      "mark": {"type": "bar", "size": 50, "cornerRadius": 5},
      "encoding": {
        "x": {
          "field": "YearInt", 
          "type": "quantitative", 
          "scale": {"domain": [2012, 2021]},
          "axis": {"format": "d", "title": "Fiscal Year"}
        },
        "y": {"field": "ratio", "type": "quantitative", "axis": {"format": "%", "title": "% Dependency"}},
        "color": {
          "field": "ratio",
          "type": "quantitative",
          "scale": {"scheme": "blues"},
          "legend": null
        },
        "tooltip": [
          {"field": "YearInt", "type": "quantitative", "title": "Year"},
          {"field": "ratio", "type": "quantitative", "title": "Dependency", "format": ".1%"}
        ]
      }
    }
  ],
  "config": {
    "background": "white",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
