{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Unique multi-idiom visualization of the Desalination Surge",
  "width": "container",
  "height": 450,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "params": [
    {
      "name": "showModern",
      "value": false
    },
    {
      "name": "pulseFocus",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Any desalination",
          "High pulse only",
          "No desalination"
        ],
        "name": "Pulse filter "
      }
    }
  ],
  "title": {
    "text": "The Desalination Pulse",
    "subtitle": "Quantifying the engineered supply response: seawater orders vs. urban demand (2012-13 to 2024-25)",
    "anchor": "start",
    "color": "#2C3E50",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#7F8C8D",
    "offset": 40
  },
  "data": {
    "url": "data/final/chart9_supply_dynamics.csv"
  },
  "transform": [
    {
      "filter": "showModern || datum.YearInt <= 2021"
    },
    {
      "calculate": "datum.Desalination_Delivered_GL >= 100 ? 'High pulse only' : datum.Desalination_Delivered_GL > 0 ? 'Any desalination' : 'No desalination'",
      "as": "PulseClass"
    },
    {
      "filter": "pulseFocus == 'All' || datum.PulseClass == pulseFocus || (pulseFocus == 'Any desalination' && datum.Desalination_Delivered_GL > 0)"
    }
  ],
  "vconcat": [
    {
      "width": "container",
      "height": 220,
      "title": {
        "text": "The Supply Collision: Traditional Catchments vs. The Pulse",
        "fontSize": 14,
        "anchor": "start",
        "color": "#34495E"
      },
      "layer": [
        {
          "mark": {
            "type": "area",
            "color": "#BDC3C7",
            "opacity": 0.2,
            "interpolate": "monotone"
          },
          "encoding": {
            "x": {
              "field": "YearInt",
              "type": "quantitative",
              "scale": {
                "domain": [
                  2011.7,
                  2024.55
                ],
                "nice": false
              },
              "axis": {
                "format": "d",
                "title": "Fiscal Year",
                "values": [
                  2012,
                  2013,
                  2014,
                  2015,
                  2016,
                  2017,
                  2018,
                  2019,
                  2020,
                  2021,
                  2022,
                  2023,
                  2024
                ],
                "grid": true,
                "gridColor": "rgba(44,62,80,0.10)"
              }
            },
            "y": {
              "field": "Total_Demand_GL",
              "type": "quantitative",
              "title": "Gigalitres (GL)",
              "axis": {
                "grid": true,
                "gridColor": "rgba(44,62,80,0.10)"
              }
            },
            "tooltip": [
              {
                "field": "YearInt",
                "type": "quantitative",
                "title": "Year"
              },
              {
                "field": "Total_Demand_GL",
                "type": "quantitative",
                "title": "Total Demand (GL)"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "area",
            "color": "#3498DB",
            "opacity": 0.8,
            "interpolate": "step-after"
          },
          "encoding": {
            "x": {
              "field": "YearInt",
              "type": "quantitative"
            },
            "y": {
              "field": "Desalination_Delivered_GL",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "YearInt",
                "type": "quantitative",
                "title": "Year"
              },
              {
                "field": "Desalination_Delivered_GL",
                "type": "quantitative",
                "title": "Desal GL"
              },
              {
                "field": "Total_Demand_GL",
                "type": "quantitative",
                "title": "Total Demand GL"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "dy": -10,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#2980B9"
          },
          "encoding": {
            "x": {
              "field": "YearInt",
              "type": "quantitative"
            },
            "y": {
              "field": "Desalination_Delivered_GL",
              "type": "quantitative"
            },
            "text": {
              "condition": {
                "test": "datum.Desalination_Delivered_GL > 0",
                "field": "Desalination_Delivered_GL",
                "type": "quantitative"
              },
              "value": ""
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "YearInt": 2020,
                "Desalination_Delivered_GL": 125,
                "YearInt2": 2017.65,
                "Desalination_Delivered_GL2": 173
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#2980B9",
            "strokeWidth": 2,
            "opacity": 0.85
          },
          "encoding": {
            "x": {
              "field": "YearInt",
              "type": "quantitative"
            },
            "y": {
              "field": "Desalination_Delivered_GL",
              "type": "quantitative"
            },
            "x2": {
              "field": "YearInt2"
            },
            "y2": {
              "field": "Desalination_Delivered_GL2"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "YearInt": 2017.45,
                "Desalination_Delivered_GL": 190,
                "text": "125 GL delivered|2020-21 & 2021-22"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#2980B9",
            "lineBreak": "|"
          },
          "encoding": {
            "x": {
              "field": "YearInt",
              "type": "quantitative"
            },
            "y": {
              "field": "Desalination_Delivered_GL",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    },
    {
      "width": "container",
      "height": 100,
      "title": {
        "text": "The Dependency Ratio (Desalination as % of Urban Demand)",
        "fontSize": 14,
        "anchor": "start",
        "color": "#34495E"
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "size": 30,
            "cornerRadius": 5
          },
          "encoding": {
            "x": {
              "field": "YearInt",
              "type": "quantitative",
              "scale": {
                "domain": [
                  2011.7,
                  2024.55
                ],
                "nice": false
              },
              "axis": {
                "format": "d",
                "title": "Fiscal Year",
                "values": [
                  2012,
                  2013,
                  2014,
                  2015,
                  2016,
                  2017,
                  2018,
                  2019,
                  2020,
                  2021,
                  2022,
                  2023,
                  2024
                ],
                "grid": true,
                "gridColor": "rgba(44,62,80,0.10)"
              }
            },
            "y": {
              "field": "ratio",
              "type": "quantitative",
              "axis": {
                "format": "%",
                "title": "% Dependency",
                "grid": true,
                "gridColor": "rgba(44,62,80,0.10)"
              }
            },
            "color": {
              "field": "ratio",
              "type": "quantitative",
              "scale": {
                "scheme": "blues"
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "YearInt",
                "type": "quantitative",
                "title": "Year"
              },
              {
                "field": "ratio",
                "type": "quantitative",
                "title": "Dependency",
                "format": ".1%"
              }
            ]
          },
          "transform": [
            {
              "calculate": "datum.Desalination_Delivered_GL / datum.Total_Demand_GL",
              "as": "ratio"
            }
          ]
        },
        {
          "data": {
            "values": [
              {
                "YearInt": 2020,
                "ratio": 0.288,
                "YearInt2": 2017.55,
                "ratio2": 0.355
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#2C3E50",
            "strokeWidth": 2,
            "opacity": 0.85
          },
          "encoding": {
            "x": {
              "field": "YearInt",
              "type": "quantitative"
            },
            "y": {
              "field": "ratio",
              "type": "quantitative"
            },
            "x2": {
              "field": "YearInt2"
            },
            "y2": {
              "field": "ratio2"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "YearInt": 2017.35,
                "ratio": 0.36,
                "text": "Peak share|28.8% in 2020-21"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#2C3E50",
            "lineBreak": "|"
          },
          "encoding": {
            "x": {
              "field": "YearInt",
              "type": "quantitative"
            },
            "y": {
              "field": "ratio",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "background": "white",
    "view": {
      "stroke": "transparent"
    },
    "font": "Source Sans Pro"
  }
}
