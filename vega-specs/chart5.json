{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": {
    "left": 20,
    "top": 20,
    "right": 20,
    "bottom": 20
  },
  "spacing": 60,
  "params": [
    {
      "name": "periodFocus",
      "value": "Overview (2004-2020)",
      "bind": {
        "input": "select",
        "options": [
          "Overview (2004-2020)",
          "Millennium Drought (2006-2009)",
          "Recovery ramp (2010-2012)",
          "Late dry-down (2017-2020)"
        ],
        "name": "Zoom period "
      }
    },
    {
      "name": "catchStartYear",
      "value": 2004,
      "bind": {
        "input": "range",
        "min": 2004,
        "max": 2020,
        "step": 0.1,
        "name": "Start year "
      }
    },
    {
      "name": "catchEndYear",
      "value": 2020,
      "bind": {
        "input": "range",
        "min": 2004,
        "max": 2020,
        "step": 0.1,
        "name": "End year "
      }
    }
  ],
  "vconcat": [
    {
      "title": {
        "text": "The Catchment Stress",
        "subtitle": "Rainfall Anomaly vs. Thermal Intensity | drag across bars to filter the reservoir panel",
        "anchor": "start",
        "color": "#E0F2FE",
        "fontSize": 24,
        "subtitleFontSize": 16,
        "subtitleColor": "#A9CCE3"
      },
      "width": "container",
      "height": 300,
      "layer": [
        {
          "data": {
            "url": "data/final/chart5_caulfield_rain.csv"
          },
          "params": [
            {
              "name": "catchmentBrush",
              "select": {
                "type": "interval",
                "encodings": [
                  "x"
                ],
                "mark": {
                  "fill": "#E0F2FE",
                  "fillOpacity": 0.12,
                  "stroke": "#FCFDBF",
                  "strokeWidth": 1
                }
              }
            }
          ],
          "transform": [
            {
              "calculate": "{'Jan':0,'Feb':1,'Mar':2,'Apr':3,'May':4,'Jun':5,'Jul':6,'Aug':7,'Sep':8,'Oct':9,'Nov':10,'Dec':11}[datum.Month]",
              "as": "MonthNum"
            },
            {
              "calculate": "datetime(datum.Year, datum.MonthNum, 1)",
              "as": "Date"
            },
            {
              "calculate": "toNumber(datum.Year) + datum.MonthNum / 12",
              "as": "DecimalYear"
            },
            {
              "calculate": "datum.Rainfall_mm - 50.6",
              "as": "Anomaly"
            },
            {
              "filter": "datum.Year >= 2004 && datum.Year <= 2019 && (periodFocus == 'Overview (2004-2020)' || (periodFocus == 'Millennium Drought (2006-2009)' && datum.Year >= 2006 && datum.Year <= 2009) || (periodFocus == 'Recovery ramp (2010-2012)' && datum.Year >= 2010 && datum.Year <= 2012) || (periodFocus == 'Late dry-down (2017-2020)' && datum.Year >= 2017 && datum.Year <= 2019))"
            },
            {
              "filter": "datum.DecimalYear >= (catchStartYear <= catchEndYear ? catchStartYear : catchEndYear) && datum.DecimalYear <= (catchStartYear <= catchEndYear ? catchEndYear : catchStartYear)"
            }
          ],
          "mark": {
            "type": "bar",
            "tooltip": true,
            "width": {
              "expr": "max(5, min(22, 260 / max(1, abs(catchEndYear - catchStartYear) * 12)))"
            }
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal",
              "axis": {
                "title": null,
                "labelExpr": "''",
                "ticks": false,
                "domain": false
              }
            },
            "y": {
              "field": "Anomaly",
              "type": "quantitative",
              "title": "Anomaly (mm)",
              "axis": {
                "gridColor": "rgba(255,255,255,0.1)",
                "labelFontSize": 11,
                "labelColor": "white",
                "titleColor": "white"
              }
            },
            "color": {
              "field": "MaxTemp",
              "type": "quantitative",
              "scale": {
                "scheme": "magma",
                "domain": [
                  10,
                  35
                ]
              },
              "legend": {
                "title": "Heat (\u00b0C)",
                "orient": "bottom",
                "direction": "horizontal",
                "gradientLength": 500,
                "labelColor": "white",
                "titleColor": "white"
              }
            },
            "tooltip": [
              {
                "field": "Date",
                "type": "temporal",
                "title": "Month",
                "format": "%b %Y"
              },
              {
                "field": "Rainfall_mm",
                "type": "quantitative",
                "title": "Total Rain (mm)"
              },
              {
                "field": "Anomaly",
                "type": "quantitative",
                "title": "Anomaly (mm)",
                "format": ".1f"
              },
              {
                "field": "MaxTemp",
                "type": "quantitative",
                "title": "Avg Temp (\u00b0C)",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "Date": "2006-10-01",
                "Anomaly": -50,
                "Date2": "2008-01-01",
                "Anomaly2": -110,
                "Period": "Millennium Drought (2006-2009)",
                "DecimalYear": 2008.0
              }
            ]
          },
          "transform": [
            {
              "filter": "periodFocus == 'Overview (2004-2020)' || periodFocus == datum.Period"
            },
            {
              "filter": "datum.DecimalYear >= (catchStartYear <= catchEndYear ? catchStartYear : catchEndYear) && datum.DecimalYear <= (catchStartYear <= catchEndYear ? catchEndYear : catchStartYear)"
            }
          ],
          "mark": {
            "type": "rule",
            "color": "#FCFDBF",
            "strokeWidth": 2,
            "opacity": 0.85
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal"
            },
            "y": {
              "field": "Anomaly",
              "type": "quantitative"
            },
            "x2": {
              "field": "Date2"
            },
            "y2": {
              "field": "Anomaly2"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "Date": "2008-01-01",
                "Anomaly": -110,
                "text": "Repeated deficits|2006-2009",
                "Period": "Millennium Drought (2006-2009)",
                "DecimalYear": 2008.0
              }
            ]
          },
          "transform": [
            {
              "filter": "periodFocus == 'Overview (2004-2020)' || periodFocus == datum.Period"
            },
            {
              "filter": "datum.DecimalYear >= (catchStartYear <= catchEndYear ? catchStartYear : catchEndYear) && datum.DecimalYear <= (catchStartYear <= catchEndYear ? catchEndYear : catchStartYear)"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#FCFDBF",
            "lineBreak": "|"
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal"
            },
            "y": {
              "field": "Anomaly",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "The Reservoir Response",
        "subtitle": "Melbourne Reservoir Storage Levels (%) | responds to the brush above",
        "anchor": "start",
        "color": "#E0F2FE",
        "fontSize": 24,
        "subtitleFontSize": 16,
        "subtitleColor": "#A9CCE3"
      },
      "width": "container",
      "height": 200,
      "layer": [
        {
          "data": {
            "url": "data/final/chart5_Historical_Data.csv"
          },
          "transform": [
            {
              "calculate": "datetime(datum.Year, datum.Month_Num - 1, 1)",
              "as": "Date"
            },
            {
              "calculate": "toNumber(datum.Year) + (datum.Month_Num - 1) / 12",
              "as": "DecimalYear"
            },
            {
              "filter": "isValid(datum.Storage_Percentage) && datum.Year >= 2004 && datum.Year <= 2020 && (periodFocus == 'Overview (2004-2020)' || (periodFocus == 'Millennium Drought (2006-2009)' && datum.Year >= 2006 && datum.Year <= 2009) || (periodFocus == 'Recovery ramp (2010-2012)' && datum.Year >= 2010 && datum.Year <= 2012) || (periodFocus == 'Late dry-down (2017-2020)' && datum.Year >= 2017 && datum.Year <= 2020))"
            },
            {
              "filter": "datum.DecimalYear >= (catchStartYear <= catchEndYear ? catchStartYear : catchEndYear) && datum.DecimalYear <= (catchStartYear <= catchEndYear ? catchEndYear : catchStartYear)"
            },
            {
              "filter": {
                "param": "catchmentBrush"
              }
            }
          ],
          "mark": {
            "type": "area",
            "line": {
              "color": "#3498DB",
              "strokeWidth": 3
            },
            "color": {
              "gradient": "linear",
              "stops": [
                {
                  "offset": 0,
                  "color": "rgba(52, 152, 219, 0.4)"
                },
                {
                  "offset": 1,
                  "color": "rgba(52, 152, 219, 0)"
                }
              ]
            },
            "interpolate": "monotone"
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal",
              "title": "Timeline",
              "axis": {
                "domainColor": "#A9CCE3",
                "labelColor": "white",
                "titleColor": "white",
                "labelFontSize": 11,
                "grid": false
              }
            },
            "y": {
              "field": "Storage_Percentage",
              "type": "quantitative",
              "title": "Storage %",
              "scale": {
                "domain": [
                  0,
                  100
                ]
              },
              "axis": {
                "titleColor": "white",
                "labelColor": "white",
                "labelFontSize": 11
              }
            },
            "tooltip": [
              {
                "field": "Date",
                "type": "temporal",
                "title": "Month",
                "format": "%b %Y"
              },
              {
                "field": "Storage_Percentage",
                "type": "quantitative",
                "title": "Storage %",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "Date": "2009-06-01",
                "Storage_Percentage": 26,
                "Date2": "2006-06-01",
                "Storage_Percentage2": 18,
                "Period": "Millennium Drought (2006-2009)",
                "DecimalYear": 2009.45
              }
            ]
          },
          "transform": [
            {
              "filter": "periodFocus == 'Overview (2004-2020)' || periodFocus == datum.Period"
            },
            {
              "filter": "datum.DecimalYear >= (catchStartYear <= catchEndYear ? catchStartYear : catchEndYear) && datum.DecimalYear <= (catchStartYear <= catchEndYear ? catchEndYear : catchStartYear)"
            },
            {
              "filter": {
                "param": "catchmentBrush"
              }
            }
          ],
          "mark": {
            "type": "rule",
            "color": "#E0F2FE",
            "strokeWidth": 2,
            "opacity": 0.85
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal"
            },
            "y": {
              "field": "Storage_Percentage",
              "type": "quantitative"
            },
            "x2": {
              "field": "Date2"
            },
            "y2": {
              "field": "Storage_Percentage2"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "Date": "2006-06-01",
                "Storage_Percentage": 18,
                "text": "Storage low|~26% in Jun 2009",
                "Period": "Millennium Drought (2006-2009)",
                "DecimalYear": 2009.45
              }
            ]
          },
          "transform": [
            {
              "filter": "periodFocus == 'Overview (2004-2020)' || periodFocus == datum.Period"
            },
            {
              "filter": "datum.DecimalYear >= (catchStartYear <= catchEndYear ? catchStartYear : catchEndYear) && datum.DecimalYear <= (catchStartYear <= catchEndYear ? catchEndYear : catchStartYear)"
            },
            {
              "filter": {
                "param": "catchmentBrush"
              }
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#E0F2FE",
            "lineBreak": "|"
          },
          "encoding": {
            "x": {
              "field": "Date",
              "type": "temporal"
            },
            "y": {
              "field": "Storage_Percentage",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared"
    }
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFont": "Source Sans Pro",
      "titleFont": "Source Sans Pro"
    }
  }
}
