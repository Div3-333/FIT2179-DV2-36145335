{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1200,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "padding": {"left": 20, "top": 20, "right": 20, "bottom": 20},
  "spacing": 60,
  "vconcat": [
    {
      "title": {
        "text": "The Catchment Stress",
        "subtitle": "Rainfall Anomaly vs. Thermal Intensity | 2004 - 2019",
        "anchor": "start",
        "color": "#E0F2FE",
        "fontSize": 24,
        "subtitleFontSize": 16,
        "subtitleColor": "#A9CCE3"
      },
      "width": 1200,
      "height": 300,
      "data": {"url": "data/final/chart5_caulfield_rain.csv"},
      "transform": [
        {
          "calculate": "{'Jan':0,'Feb':1,'Mar':2,'Apr':3,'May':4,'Jun':5,'Jul':6,'Aug':7,'Sep':8,'Oct':9,'Nov':10,'Dec':11}[datum.Month]",
          "as": "MonthNum"
        },
        {"calculate": "datetime(datum.Year, datum.MonthNum, 1)", "as": "Date"},
        {"calculate": "datum.Rainfall_mm - 50.6", "as": "Anomaly"}
      ],
      "mark": {"type": "bar", "tooltip": true, "width": 6},
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "axis": {"title": null, "labelExpr": "''", "ticks": false, "domain": false},
          "scale": {"domain": ["2003-12-01", "2020-02-01"]}
        },
        "y": {
          "field": "Anomaly",
          "type": "quantitative",
          "title": "Anomaly (mm)",
          "axis": {
            "gridColor": "rgba(255,255,255,0.1)", 
            "labelFontSize": 11,
            "labelColor": "white",
            "titleColor": "white"
          }
        },
        "color": {
          "field": "MaxTemp",
          "type": "quantitative",
          "scale": {
            "scheme": "magma",
            "domain": [10, 35],
            "reverse": false
          },
          "legend": {
            "title": "Heat (°C)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 500,
            "labelColor": "white",
            "titleColor": "white"
          }
        },
        "tooltip": [
          {"field": "Date", "type": "temporal", "title": "Month", "format": "%b %Y"},
          {"field": "Rainfall_mm", "type": "quantitative", "title": "Total Rain (mm)"},
          {"field": "Anomaly", "type": "quantitative", "title": "Anomaly (mm)", "format": ".1f"},
          {"field": "MaxTemp", "type": "quantitative", "title": "Avg Temp (°C)", "format": ".1f"}
        ]
      }
    },
    {
      "title": {
        "text": "The Reservoir Response",
        "subtitle": "Melbourne Reservoir Storage Levels (%)",
        "anchor": "start",
        "color": "#E0F2FE",
        "fontSize": 24,
        "subtitleFontSize": 16,
        "subtitleColor": "#A9CCE3"
      },
      "width": 1200,
      "height": 200,
      "data": {"url": "data/final/chart5_Historical_Data.csv"},
      "transform": [
        {"calculate": "datetime(datum.Year, datum.Month_Num - 1, 1)", "as": "Date"},
        {"filter": "datum.Year >= 2004 && datum.Year <= 2019"}
      ],
      "mark": {
        "type": "area",
        "line": {"color": "#3498DB", "strokeWidth": 3},
        "color": {
          "gradient": "linear",
          "stops": [
            {"offset": 0, "color": "rgba(52, 152, 219, 0.4)"},
            {"offset": 1, "color": "rgba(52, 152, 219, 0)"}
          ]
        },
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "title": "Timeline",
          "scale": {"domain": ["2003-12-01", "2020-02-01"]},
          "axis": {
            "domainColor": "#A9CCE3", 
            "labelColor": "white", 
            "titleColor": "white", 
            "labelFontSize": 11,
            "grid": false
          }
        },
        "y": {
          "field": "Storage_Percentage",
          "type": "quantitative",
          "title": "Storage %",
          "scale": {"domain": [0, 100]},
          "axis": {
            "titleColor": "white", 
            "labelColor": "white", 
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {"field": "Date", "type": "temporal", "title": "Month", "format": "%b %Y"},
          {"field": "Storage_Percentage", "type": "quantitative", "title": "Storage %", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "axis": {"labelFont": "Source Sans Pro", "titleFont": "Source Sans Pro"}
  }
}
