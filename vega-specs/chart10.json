{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "High-fidelity supply-demand gap analysis for Greater Melbourne.",
  "width": 1100,
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "transparent",
  "title": {
    "text": "The Survival Balance Sheet",
    "subtitle": "Quantifying the 'Engineered Gap': Natural Reservoir Yield vs. The Desalination Wedge (2012-2021)",
    "anchor": "start",
    "color": "#2C3E50",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#7F8C8D",
    "offset": 40
  },
  "data": {"url": "data/final/chart10_engineered_shift.csv"},
  "params": [
    {
      "name": "selectYear",
      "value": 2021,
      "bind": {"input": "range", "min": 2012, "max": 2021, "step": 1, "name": "Audit Year: "}
    }
  ],
  "hconcat": [
    {
      "width": 800,
      "height": 300,
      "layer": [
        {
          "mark": {"type": "area", "color": "#BDC3C7", "opacity": 0.1},
          "encoding": {
            "x": {"field": "YearInt", "type": "quantitative", "axis": {"format": "d", "title": "Fiscal Year", "grid": false}},
            "y": {"field": "Total_Demand_GL", "type": "quantitative", "title": "Gigalitres (GL)", "scale": {"domain": [0, 500]}}
          }
        },
        {
          "mark": {"type": "area", "color": "#3498DB", "opacity": 0.8},
          "encoding": {
            "x": {"field": "YearInt", "type": "quantitative"},
            "y": {"field": "Natural_Yield_GL", "type": "quantitative"}
          }
        },
        {
          "mark": {"type": "area", "color": "#F1C40F", "opacity": 0.9},
          "encoding": {
            "x": {"field": "YearInt", "type": "quantitative"},
            "y": {"field": "Natural_Yield_GL", "type": "quantitative"},
            "y2": {"field": "Total_Demand_GL", "type": "quantitative"},
            "opacity": {
              "condition": {"test": "datum.Desalination_Delivered_GL > 0", "value": 0.9},
              "value": 0
            }
          }
        },
        {
          "transform": [{"filter": "datum.YearInt == selectYear"}],
          "mark": {"type": "rule", "color": "#2C3E50", "strokeWidth": 2, "strokeDash": [4, 4]},
          "encoding": {"x": {"field": "YearInt", "type": "quantitative"}}
        }
      ]
    },
    {
      "width": 250,
      "height": 300,
      "title": {"text": "Forensic Supply HUD", "fontSize": 14, "color": "#2C3E50", "anchor": "middle"},
      "transform": [
        {"filter": "datum.YearInt == selectYear"},
        {"calculate": "datum.Desalination_Delivered_GL / datum.Total_Demand_GL", "as": "resilience"}
      ],
      "layer": [
        {
          "mark": {"type": "arc", "innerRadius": 60, "outerRadius": 90, "theta": 1.57, "color": "#ECF0F1"}
        },
        {
          "mark": {"type": "arc", "innerRadius": 60, "outerRadius": 90, "theta": 1.57},
          "encoding": {
            "color": {"value": "#F1C40F"},
            "theta": {"field": "resilience", "type": "quantitative", "scale": {"domain": [0, 1]}}
          }
        },
        {
          "mark": {"type": "text", "fontSize": 32, "fontWeight": "bold", "color": "#2C3E50", "dy": 0},
          "encoding": {"text": {"field": "resilience", "type": "quantitative", "format": ".1%"}}
        },
        {
          "mark": {"type": "text", "fontSize": 12, "color": "#7F8C8D", "dy": 30},
          "encoding": {"text": {"value": "Engineered Dependency"}}
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
