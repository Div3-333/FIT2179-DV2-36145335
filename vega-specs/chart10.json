{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Multi-idiom industrial console for water engineering.",
  "width": 1100,
  "height": 400,
  "background": "transparent",
  "params": [
    {
      "name": "selectYear",
      "value": 2021,
      "bind": {"input": "range", "min": 2012, "max": 2021, "step": 1, "name": "Audit Year: "}
    }
  ],
  "hconcat": [
    {
      "width": 300,
      "height": 300,
      "title": {"text": "Supply Blend (Engineered vs Natural)", "fontSize": 14, "color": "#2C3E50", "anchor": "middle"},
      "data": {"url": "data/final/chart10_console_data.csv"},
      "transform": [
        {"filter": "datum.YearInt == selectYear"},
        {"calculate": "datum.Residential_GL + datum.Non_Residential_GL + datum.Non_Revenue_GL", "as": "Total"},
        {"calculate": "datum.Desalination_Delivered_GL / datum.Total", "as": "desalRatio"}
      ],
      "layer": [
        {"mark": {"type": "arc", "innerRadius": 70, "outerRadius": 100, "theta": 1.57, "color": "#ECF0F1"}},
        {
          "mark": {"type": "arc", "innerRadius": 70, "outerRadius": 100, "theta": 1.57},
          "encoding": {
            "theta": {"field": "desalRatio", "type": "quantitative", "scale": {"domain": [0, 1]}},
            "color": {"value": "#F1C40F"}
          }
        },
        {
          "mark": {"type": "text", "fontSize": 32, "fontWeight": "bold", "color": "#2C3E50"},
          "encoding": {"text": {"field": "desalRatio", "type": "quantitative", "format": ".1%"}}
        },
        {
          "mark": {"type": "text", "fontSize": 12, "color": "#7F8C8D", "dy": 30},
          "encoding": {"text": {"value": "SEAWATER RATIO"}}
        }
      ]
    },
    {
      "width": 400,
      "height": 300,
      "title": {"text": "Usage Profile (Who Consumes?)", "fontSize": 14, "color": "#2C3E50", "anchor": "middle"},
      "data": {"url": "data/final/chart10_console_data.csv"},
      "transform": [
        {"filter": "datum.YearInt == selectYear"},
        {"fold": ["Residential_GL", "Non_Residential_GL"], "as": ["Type", "GL"]}
      ],
      "mark": {"type": "arc", "innerRadius": 50, "stroke": "white", "strokeWidth": 2},
      "encoding": {
        "theta": {"field": "GL", "type": "quantitative"},
        "color": {
          "field": "Type",
          "type": "nominal",
          "scale": {"range": ["#3498DB", "#2E86C1"]},
          "legend": {"orient": "bottom", "title": null, "labelFontSize": 12}
        },
        "tooltip": [{"field": "Type", "type": "nominal"}, {"field": "GL", "type": "quantitative", "title": "Amount (GL)"}]
      }
    },
    {
      "width": 300,
      "height": 300,
      "title": {"text": "Network Efficiency (Loss HUD)", "fontSize": 14, "color": "#2C3E50", "anchor": "middle"},
      "data": {"url": "data/final/chart10_console_data.csv"},
      "transform": [
        {"filter": "datum.YearInt == selectYear"},
        {"calculate": "datum.Non_Revenue_GL", "as": "Loss"}
      ],
      "layer": [
        {
          "mark": {"type": "bar", "width": 40, "color": "#ECF0F1", "cornerRadius": 5},
          "encoding": {"y": {"datum": 100, "type": "quantitative", "scale": {"domain": [0, 100]}, "title": "GL Loss / Leakage"}}
        },
        {
          "mark": {"type": "bar", "width": 40, "color": "#E67E22", "cornerRadius": 5},
          "encoding": {"y": {"field": "Loss", "type": "quantitative"}}
        },
        {
          "mark": {"type": "text", "fontSize": 24, "fontWeight": "900", "color": "#E67E22", "dx": 60},
          "encoding": {"text": {"field": "Loss", "type": "quantitative", "format": ".0f"}}
        },
        {
          "mark": {"type": "text", "fontSize": 12, "color": "#7F8C8D", "dx": 60, "dy": 25},
          "encoding": {"text": {"value": "GL LEAKAGE"}}
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
