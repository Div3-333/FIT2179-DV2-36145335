{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "High-fidelity industrial dashboard: The Survival Envelope.",
  "width": 800,
  "height": 550,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "transparent",
  "title": {
    "text": "The Survival Envelope",
    "subtitle": "System Resilience Scan: Reservoir Health vs. Engineering Injection | 2012 - 2025",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 40
  },
  "data": {"url": "data/final/chart10_resilience_matrix.csv"},
  "params": [
    {
      "name": "hover",
      "select": {"type": "point", "on": "mouseover", "clear": "mouseout", "nearest": true}
    }
  ],
  "layer": [
    {
      "name": "QUADRANT_LABELS",
      "data": {
        "values": [
          {"x": 90, "y": 10, "text": "SAFE ZONE"},
          {"x": 50, "y": 10, "text": "CRITICAL STRESS"},
          {"x": 50, "y": 130, "text": "ENGINEERED SURVIVAL"},
          {"x": 90, "y": 130, "text": "ARTIFICIAL RECHARGE"}
        ]
      },
      "mark": {"type": "text", "fontSize": 14, "fontWeight": 900, "opacity": 0.2, "color": "#D7CCC8"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "text"}
      }
    },
    {
      "name": "TRAJECTORY",
      "mark": {"type": "line", "point": false, "strokeWidth": 2, "color": "white", "opacity": 0.2, "interpolate": "monotone"},
      "encoding": {
        "x": {"field": "Storage_Percentage", "type": "quantitative"},
        "y": {"field": "Desalination_Delivered_GL", "type": "quantitative"},
        "order": {"field": "Year", "type": "quantitative"}
      }
    },
    {
      "name": "DATA_POINTS",
      "mark": {"type": "point", "size": 300, "filled": true, "stroke": "white", "strokeWidth": 1.5},
      "encoding": {
        "x": {
          "field": "Storage_Percentage",
          "type": "quantitative",
          "scale": {"domain": [40, 100]},
          "axis": {"title": "Reservoir Health (Average Storage %)", "labelColor": "#D7CCC8", "titleColor": "#D7CCC8", "grid": false}
        },
        "y": {
          "field": "Desalination_Delivered_GL",
          "type": "quantitative",
          "scale": {"domain": [-5, 150]},
          "axis": {"title": "Engineering Injection (Desal GL)", "labelColor": "#D7CCC8", "titleColor": "#D7CCC8", "grid": false}
        },
        "color": {
          "field": "Year",
          "type": "quantitative",
          "scale": {"scheme": "magma"},
          "legend": {"title": "Timeline", "labelColor": "#D7CCC8", "titleColor": "#D7CCC8", "format": "d"}
        },
        "opacity": {
          "condition": {"param": "hover", "value": 1, "empty": true},
          "value": 0.4
        },
        "size": {
          "condition": {"param": "hover", "value": 600, "empty": false},
          "value": 300
        },
        "tooltip": [
          {"field": "Year", "type": "quantitative", "title": "Year"},
          {"field": "Storage_Percentage", "type": "quantitative", "title": "Storage %", "format": ".1f"},
          {"field": "Desalination_Delivered_GL", "type": "quantitative", "title": "Desal (GL)"}
        ]
      }
    },
    {
      "name": "YEAR_LABELS",
      "mark": {"type": "text", "dy": -20, "fontSize": 12, "fontWeight": "bold", "color": "white"},
      "encoding": {
        "x": {"field": "Storage_Percentage", "type": "quantitative"},
        "y": {"field": "Desalination_Delivered_GL", "type": "quantitative"},
        "text": {"field": "Year", "type": "nominal"},
        "opacity": {
          "condition": {"param": "hover", "value": 1, "empty": false},
          "value": 0
        }
      }
    },
    {
      "name": "FORENSIC_HUD",
      "transform": [{"filter": {"param": "hover"}}],
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 20,
            "fontWeight": 900,
            "color": "#F1C40F",
            "x": 20,
            "y": 20
          },
          "encoding": {
            "text": {
              "calculate": "'SYSTEM STATUS: ' + (datum.Storage_Percentage < 65 ? 'CRITICAL' : 'RECOVERY')",
              "as": "statusText"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
