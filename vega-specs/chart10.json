{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "High-fidelity industrial dashboard: The Circular Survival Matrix.",
  "width": "container",
  "height": 450,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "padding": {
    "left": 20,
    "top": 50,
    "right": 20,
    "bottom": 20
  },
  "title": {
    "text": "The Survival Cycle",
    "subtitle": "Circular Resilience Scan: The Journey from Nature to Engineering and Back | 2012 - 2025",
    "anchor": "start",
    "color": "#2C3E50",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#7F8C8D",
    "offset": 40
  },
  "data": {
    "url": "data/final/chart10_resilience_matrix.csv"
  },
  "params": [
    {
      "name": "showModern",
      "value": false
    }
  ],
  "transform": [
    {
      "calculate": "toNumber(datum.Year)",
      "as": "YearNum"
    },
    {
      "filter": "showModern || datum.YearNum <= 2021"
    }
  ],
  "layer": [
    {
      "name": "CROSSHAIR_AXES",
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#2C3E50",
            "strokeWidth": 2,
            "opacity": 0.2
          },
          "encoding": {
            "x": {
              "datum": 70,
              "type": "quantitative",
              "scale": {
                "domain": [
                  40,
                  100
                ]
              }
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#2C3E50",
            "strokeWidth": 2,
            "opacity": 0.2
          },
          "encoding": {
            "y": {
              "datum": 75,
              "type": "quantitative",
              "scale": {
                "domain": [
                  -5,
                  150
                ]
              }
            }
          }
        }
      ]
    },
    {
      "name": "QUADRANT_LABELS",
      "data": {
        "values": [
          {
            "x": 55,
            "y": 140,
            "text": "ENGINEERED BUFFER"
          },
          {
            "x": 85,
            "y": 140,
            "text": "SUPPLY BUFFER"
          },
          {
            "x": 85,
            "y": 10,
            "text": "STABLE STORAGE"
          },
          {
            "x": 55,
            "y": 10,
            "text": "UNBUFFERED STRESS"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 900,
        "color": "black",
        "opacity": 0.4
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "name": "TRAJECTORY",
      "mark": {
        "type": "line",
        "point": false,
        "strokeWidth": 2.5,
        "color": "#2C3E50",
        "opacity": 0.1,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Storage_Percentage",
          "type": "quantitative"
        },
        "y": {
          "field": "Desalination_Delivered_GL",
          "type": "quantitative"
        },
        "order": {
          "field": "YearNum",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "DATA_POINTS",
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "nearest": true
          }
        }
      ],
      "mark": {
        "type": "circle",
        "size": 800,
        "stroke": "#2C3E50",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "Storage_Percentage",
          "type": "quantitative",
          "axis": {
            "title": "Reservoir Health (Storage %)",
            "labelColor": "#2C3E50",
            "titleColor": "#2C3E50",
            "grid": true,
            "gridColor": "rgba(44,62,80,0.10)",
            "domain": true,
            "ticks": true
          }
        },
        "y": {
          "field": "Desalination_Delivered_GL",
          "type": "quantitative",
          "axis": {
            "title": "Desalination Delivered (GL)",
            "labelColor": "#2C3E50",
            "titleColor": "#2C3E50",
            "grid": true,
            "gridColor": "rgba(44,62,80,0.10)",
            "domain": true,
            "ticks": true
          }
        },
        "color": {
          "field": "Year",
          "type": "ordinal",
          "scale": {
            "scheme": "magma",
            "domain": [
              "2012",
              "2013",
              "2014",
              "2015",
              "2016",
              "2017",
              "2018",
              "2019",
              "2020",
              "2021",
              "2022",
              "2023",
              "2024",
              "2025"
            ]
          },
          "legend": {
            "title": "Fiscal Year",
            "orient": "right",
            "labelColor": "#2C3E50",
            "titleColor": "#2C3E50"
          }
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "value": 1
          },
          "value": 0.5
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "Storage_Percentage",
            "type": "quantitative",
            "title": "Storage %",
            "format": ".1f"
          },
          {
            "field": "Desalination_Delivered_GL",
            "type": "quantitative",
            "title": "Desal GL"
          }
        ]
      }
    },
    {
      "name": "YEAR_LABELS",
      "mark": {
        "type": "text",
        "dy": 0,
        "fontSize": 12,
        "fontWeight": 900,
        "color": "white"
      },
      "encoding": {
        "x": {
          "field": "Storage_Percentage",
          "type": "quantitative"
        },
        "y": {
          "field": "Desalination_Delivered_GL",
          "type": "quantitative"
        },
        "text": {
          "field": "Year",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "value": 1,
            "empty": false
          },
          "value": 0
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Storage_Percentage": 67.5,
            "Desalination_Delivered_GL": 125,
            "Storage2": 50,
            "Desal2": 143,
            "Year": "2020"
          }
        ]
      },
      "transform": [
        {
          "calculate": "toNumber(datum.Year)",
          "as": "YearNum"
        },
        {
          "filter": "showModern || datum.YearNum <= 2021"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#E74C3C",
        "strokeWidth": 2,
        "opacity": 0.85
      },
      "encoding": {
        "x": {
          "field": "Storage_Percentage",
          "type": "quantitative"
        },
        "y": {
          "field": "Desalination_Delivered_GL",
          "type": "quantitative"
        },
        "x2": {
          "field": "Storage2"
        },
        "y2": {
          "field": "Desal2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Storage_Percentage": 48,
            "Desalination_Delivered_GL": 149,
            "text": "2020 enters|high-desal response",
            "Year": "2020"
          }
        ]
      },
      "transform": [
        {
          "calculate": "toNumber(datum.Year)",
          "as": "YearNum"
        },
        {
          "filter": "showModern || datum.YearNum <= 2021"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#E74C3C",
        "lineBreak": "|"
      },
      "encoding": {
        "x": {
          "field": "Storage_Percentage",
          "type": "quantitative"
        },
        "y": {
          "field": "Desalination_Delivered_GL",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Storage_Percentage": 92.8,
            "Desalination_Delivered_GL": 15,
            "Storage2": 84,
            "Desal2": 36,
            "Year": "2023"
          }
        ]
      },
      "transform": [
        {
          "calculate": "toNumber(datum.Year)",
          "as": "YearNum"
        },
        {
          "filter": "showModern || datum.YearNum <= 2021"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#B9770E",
        "strokeWidth": 2,
        "opacity": 0.85
      },
      "encoding": {
        "x": {
          "field": "Storage_Percentage",
          "type": "quantitative"
        },
        "y": {
          "field": "Desalination_Delivered_GL",
          "type": "quantitative"
        },
        "x2": {
          "field": "Storage2"
        },
        "y2": {
          "field": "Desal2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Storage_Percentage": 83,
            "Desalination_Delivered_GL": 48,
            "text": "Return years|back rightward",
            "Year": "2023"
          }
        ]
      },
      "transform": [
        {
          "calculate": "toNumber(datum.Year)",
          "as": "YearNum"
        },
        {
          "filter": "showModern || datum.YearNum <= 2021"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#8A5A00",
        "lineBreak": "|"
      },
      "encoding": {
        "x": {
          "field": "Storage_Percentage",
          "type": "quantitative"
        },
        "y": {
          "field": "Desalination_Delivered_GL",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "font": "Source Sans Pro"
  }
}
