{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "High-fidelity industrial dashboard: The Survival Matrix.",
  "width": 1000,
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "white",
  "padding": {"left": 20, "top": 50, "right": 20, "bottom": 20},
  "title": {
    "text": "The Survival Envelope",
    "subtitle": "Temporal Matrix: Seawater Injection vs. Historical Reservoir Health | 2012 - 2021",
    "anchor": "start",
    "color": "#2C3E50",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#7F8C8D",
    "offset": 40
  },
  "data": {"url": "data/final/chart10_resilience_matrix.csv"},
  "layer": [
    {
      "name": "QUADRANT_LABELS",
      "data": {
        "values": [
          {"x": 2013, "y": 120, "text": "ENGINEERED SURVIVAL"},
          {"x": 2020, "y": 120, "text": "ARTIFICIAL RECHARGE"},
          {"x": 2013, "y": 20, "text": "SAFE ZONE"},
          {"x": 2020, "y": 20, "text": "CRITICAL STRESS"}
        ]
      },
      "mark": {"type": "text", "fontSize": 16, "fontWeight": 900, "color": "black", "opacity": 0.4},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "text"}
      }
    },
    {
      "name": "DATA_POINTS",
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "on": "mouseover", "clear": "mouseout", "nearest": true}
        }
      ],
      "mark": {"type": "point", "size": 600, "filled": true, "stroke": "#2C3E50", "strokeWidth": 2},
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "scale": {"domain": [2011, 2022]},
          "axis": {
            "format": "d",
            "title": "Timeline (Fiscal Year)",
            "labelColor": "#2C3E50",
            "titleColor": "#2C3E50",
            "grid": true,
            "gridColor": "#ECF0F1",
            "domainWidth": 2,
            "domainColor": "#2C3E50"
          }
        },
        "y": {
          "field": "Desalination_Delivered_GL",
          "type": "quantitative",
          "scale": {"domain": [-5, 150]},
          "axis": {
            "title": "Engineering Injection (Desal GL)",
            "labelColor": "#2C3E50",
            "titleColor": "#2C3E50",
            "grid": true,
            "gridColor": "#ECF0F1",
            "domainWidth": 2,
            "domainColor": "#2C3E50"
          }
        },
        "color": {
          "field": "Storage_Percentage",
          "type": "quantitative",
          "scale": {"scheme": "magma", "reverse": true},
          "legend": {"title": "Reservoir Health (%)", "orient": "right", "labelColor": "#2C3E50", "titleColor": "#2C3E50"}
        },
        "opacity": {
          "condition": {"param": "hover", "value": 1, "empty": true},
          "value": 0.3
        },
        "tooltip": [
          {"field": "Year", "type": "quantitative", "title": "Year"},
          {"field": "Storage_Percentage", "type": "quantitative", "title": "Storage Health %", "format": ".1f"},
          {"field": "Desalination_Delivered_GL", "type": "quantitative", "title": "Desal GL"}
        ]
      }
    },
    {
      "name": "YEAR_LABELS",
      "mark": {"type": "text", "dy": -25, "fontSize": 14, "fontWeight": 900, "color": "#2C3E50"},
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "Desalination_Delivered_GL", "type": "quantitative"},
        "text": {"field": "Year", "type": "nominal"},
        "opacity": {
          "condition": {"param": "hover", "value": 1, "empty": false},
          "value": 0.4
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
