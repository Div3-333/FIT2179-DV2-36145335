{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": 20,
  "title": {
    "text": "The Evaporation Trend",
    "subtitle": "Annual Water Loss and Summer Heat Intensity | 1983 - 2025 (Reliable Record)",
    "anchor": "start",
    "color": "#E0F2FE",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#A9CCE3",
    "offset": 20
  },
  "data": {
    "url": "data/final/chart4_evaporation_temp.csv"
  },
  "transform": [
    {"filter": "datum.Year < 2026"}
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#E67E22",
        "strokeWidth": 3,
        "opacity": 0.6,
        "strokeDash": [4, 2]
      },
      "transform": [
        {
          "regression": "Annual_Evaporation_mm",
          "on": "Year"
        }
      ],
      "encoding": {
        "x": {"field": "Year", "type": "quantitative", "scale": {"domain": [1980, 2028]}},
        "y": {"field": "Annual_Evaporation_mm", "type": "quantitative", "scale": {"domain": [700, 1200]}}
      }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "title": "Timeline",
          "scale": {"domain": [1980, 2028]},
          "axis": {
            "format": "d",
            "gridColor": "rgba(255,255,255,0.1)",
            "tickCount": 10
          }
        },
        "y": {
          "field": "Annual_Evaporation_mm",
          "type": "quantitative",
          "title": "Annual Evaporation (mm)",
          "scale": {"domain": [700, 1200]},
          "axis": {"gridColor": "rgba(255,255,255,0.1)"}
        },
        "color": {
          "field": "Avg_Summer_Max_Temp",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [25, 28, 31],
            "range": ["#3B0F70", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {"title": "Temp Intensity", "labelColor": "#E0F2FE", "titleColor": "#E0F2FE"}
        },
        "size": {
          "field": "Avg_Summer_Max_Temp",
          "type": "quantitative",
          "scale": {
            "domain": [25, 32],
            "range": [50, 4000]
          },
          "legend": {
            "title": "Heat Magnitude",
            "labelColor": "#E0F2FE",
            "titleColor": "#E0F2FE",
            "values": [26, 28, 30, 32]
          }
        },
        "tooltip": [
          {"field": "Year", "type": "quantitative", "title": "Year"},
          {"field": "Annual_Evaporation_mm", "type": "quantitative", "title": "Total Evaporation (mm)", "format": ".0f"},
          {"field": "Avg_Summer_Max_Temp", "type": "quantitative", "title": "Avg Summer Max (°C)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 1983 || datum.Year == 2009 || datum.Year == 2019"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 15,
        "dy": -10,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#FCFDBF"
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "Annual_Evaporation_mm", "type": "quantitative"},
        "text": {"field": "Year", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#A9CCE3",
      "tickColor": "#A9CCE3",
      "labelColor": "#E0F2FE",
      "titleColor": "#E0F2FE",
      "labelFont": "Source Sans Pro",
      "titleFont": "Source Sans Pro"
    }
  }
}
