{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "The Evaporation Pump",
    "subtitle": "Relationship between Summer Heat and Annual Water Loss | 1958 - 2026",
    "anchor": "start",
    "color": "#E0F2FE",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#A9CCE3",
    "offset": 20
  },
  "data": {
    "url": "data/final/chart4_evaporation_temp.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#E67E22",
        "strokeWidth": 3,
        "opacity": 0.4
      },
      "transform": [
        {
          "regression": "Annual_Evaporation_mm",
          "on": "Avg_Summer_Max_Temp"
        }
      ],
      "encoding": {
        "x": {"field": "Avg_Summer_Max_Temp", "type": "quantitative"},
        "y": {"field": "Annual_Evaporation_mm", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1,
        "size": 120
      },
      "encoding": {
        "x": {
          "field": "Avg_Summer_Max_Temp",
          "type": "quantitative",
          "title": "Avg Summer Max Temp (°C)",
          "scale": {"domain": [22, 33]},
          "axis": {"gridColor": "rgba(255,255,255,0.1)"}
        },
        "y": {
          "field": "Annual_Evaporation_mm",
          "type": "quantitative",
          "title": "Annual Evaporation (mm)",
          "scale": {"domain": [500, 1600]},
          "axis": {"gridColor": "rgba(255,255,255,0.1)"}
        },
        "color": {
          "field": "Avg_Summer_Max_Temp",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [22, 28, 32],
            "range": ["#3B0F70", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {"title": "Temp Intensity", "labelColor": "#E0F2FE", "titleColor": "#E0F2FE"}
        },
        "tooltip": [
          {"field": "Year", "type": "quantitative", "title": "Year"},
          {"field": "Avg_Summer_Max_Temp", "type": "quantitative", "title": "Summer Temp", "format": ".1f"},
          {"field": "Annual_Evaporation_mm", "type": "quantitative", "title": "Evaporation", "format": ".0f"}
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 1972 || datum.Year == 2009 || datum.Year == 2019 || datum.Year == 2026"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -10,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#FCFDBF"
      },
      "encoding": {
        "x": {"field": "Avg_Summer_Max_Temp", "type": "quantitative"},
        "y": {"field": "Annual_Evaporation_mm", "type": "quantitative"},
        "text": {"field": "Year", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#A9CCE3",
      "tickColor": "#A9CCE3",
      "labelColor": "#E0F2FE",
      "titleColor": "#E0F2FE",
      "labelFont": "Source Sans Pro",
      "titleFont": "Source Sans Pro"
    }
  }
}
