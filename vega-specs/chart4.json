{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "The Evaporation Trend",
    "subtitle": "Annual Water Loss and Summer Heat Intensity | 1958 - 2026",
    "anchor": "start",
    "color": "#E0F2FE",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#A9CCE3",
    "offset": 20
  },
  "data": {
    "url": "data/final/chart4_evaporation_temp.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "rgba(255,255,255,0.1)",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative", "axis": {"format": "d"}},
        "y": {"field": "Annual_Evaporation_mm", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "title": "Timeline",
          "axis": {
            "format": "d",
            "gridColor": "rgba(255,255,255,0.1)",
            "tickCount": 10
          }
        },
        "y": {
          "field": "Annual_Evaporation_mm",
          "type": "quantitative",
          "title": "Annual Evaporation (mm)",
          "scale": {"domain": [400, 1600]},
          "axis": {"gridColor": "rgba(255,255,255,0.1)"}
        },
        "color": {
          "field": "Avg_Summer_Max_Temp",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [22, 28, 32],
            "range": ["#3B0F70", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {"title": "Summer Temp (°C)", "labelColor": "#E0F2FE", "titleColor": "#E0F2FE"}
        },
        "size": {
          "field": "Avg_Summer_Max_Temp",
          "type": "quantitative",
          "scale": {"range": [50, 800]},
          "legend": null
        },
        "tooltip": [
          {"field": "Year", "type": "quantitative", "title": "Year"},
          {"field": "Annual_Evaporation_mm", "type": "quantitative", "title": "Total Evaporation (mm)", "format": ".0f"},
          {"field": "Avg_Summer_Max_Temp", "type": "quantitative", "title": "Avg Summer Max (°C)", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#A9CCE3",
      "tickColor": "#A9CCE3",
      "labelColor": "#E0F2FE",
      "titleColor": "#E0F2FE",
      "labelFont": "Source Sans Pro",
      "titleFont": "Source Sans Pro"
    }
  }
}
