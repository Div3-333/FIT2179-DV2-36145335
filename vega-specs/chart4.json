{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": 20,
  "title": {
    "text": "The Evaporation Squeeze",
    "subtitle": "Evaporation (Y), Heat (Color), and Rainfall (Size) | 1983 - 2025",
    "anchor": "start",
    "color": "#E0F2FE",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#A9CCE3",
    "offset": 20
  },
  "data": {
    "url": "data/final/chart4_evaporation_temp.csv"
  },
  "transform": [
    {"filter": "datum.Year < 2026"}
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "rgba(255,255,255,0.05)",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative", "scale": {"domain": [1980, 2028]}, "axis": {"format": "d"}},
        "y": {"field": "Annual_Evaporation_mm", "type": "quantitative", "scale": {"domain": [600, 1200]}}
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#E67E22",
        "strokeWidth": 3,
        "opacity": 0.4,
        "strokeDash": [4, 2]
      },
      "transform": [
        {
          "regression": "Annual_Evaporation_mm",
          "on": "Year"
        }
      ],
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "Annual_Evaporation_mm", "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "title": "Timeline",
          "scale": {"domain": [1980, 2028]},
          "axis": {
            "format": "d",
            "gridColor": "rgba(255,255,255,0.1)",
            "tickCount": 10
          }
        },
        "y": {
          "field": "Annual_Evaporation_mm",
          "type": "quantitative",
          "title": "Annual Evaporation (mm)",
          "scale": {"domain": [600, 1200]},
          "axis": {"gridColor": "rgba(255,255,255,0.1)"}
        },
        "color": {
          "field": "Avg_Summer_Max_Temp",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [25, 28, 31],
            "range": ["#3B0F70", "#FE9F6D", "#FCFDBF"]
          },
          "legend": {"title": "Summer Heat (°C)", "labelColor": "#E0F2FE", "titleColor": "#E0F2FE"}
        },
        "size": {
          "field": "Annual_Rainfall_mm",
          "type": "quantitative",
          "scale": {
            "domain": [350, 950],
            "range": [50, 800]
          },
          "legend": {"title": "Annual Rain (mm)", "labelColor": "#E0F2FE", "titleColor": "#E0F2FE"}
        },
        "tooltip": [
          {"field": "Year", "type": "quantitative", "title": "Year"},
          {"field": "Annual_Evaporation_mm", "type": "quantitative", "title": "Total Evaporation (mm)", "format": ".0f"},
          {"field": "Avg_Summer_Max_Temp", "type": "quantitative", "title": "Avg Summer Max (°C)", "format": ".1f"},
          {"field": "Annual_Rainfall_mm", "type": "quantitative", "title": "Annual Rain (mm)", "format": ".0f"}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#A9CCE3",
      "tickColor": "#A9CCE3",
      "labelColor": "#E0F2FE",
      "titleColor": "#E0F2FE",
      "labelFont": "Source Sans Pro",
      "titleFont": "Source Sans Pro"
    }
  }
}
