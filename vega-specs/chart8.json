{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 300,
  "height": 550,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "The Extraction Core Sample",
    "subtitle": "Water Source Proportion (100% Stacked) | 2015 - 2023",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 24,
    "subtitleFontSize": 14,
    "subtitleColor": "#B0BEC5",
    "offset": 20
  },
  "data": {
    "url": "data/final/chart8_total-use-by-resource-figure.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(substring(datum['Water year'], 0, 4))",
      "as": "YearVal"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "orient": "horizontal",
        "interpolate": "monotone",
        "opacity": 0.85
      },
      "encoding": {
        "y": {
          "field": "YearVal",
          "type": "quantitative",
          "title": "Depth of Time (Years)",
          "scale": {"reverse": true, "domain": [2015, 2022]},
          "axis": {
            "format": "d",
            "domainColor": "#B0BEC5",
            "labelColor": "#D7CCC8",
            "titleColor": "#D7CCC8",
            "grid": false,
            "tickCount": 8,
            "labelFontSize": 12
          }
        },
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "axis": null
        },
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": {
            "orient": "right",
            "title": "Strata (Resource)",
            "labelColor": "#D7CCC8",
            "titleColor": "#D7CCC8",
            "symbolType": "square"
          }
        },
        "tooltip": [
          {"field": "Water year", "type": "nominal", "title": "Year"},
          {"field": "Resource_Type", "type": "nominal", "title": "Source"},
          {"field": "Volume_ML", "type": "quantitative", "title": "Volume (ML)", "format": ","}
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "shape": "triangle-down",
        "filled": true,
        "size": 80,
        "opacity": 0.9,
        "color": "#E0F2FE",
        "stroke": "#2C3E50",
        "strokeWidth": 0.5
      },
      "encoding": {
        "y": {
          "field": "YearVal",
          "type": "quantitative"
        },
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize"
        },
        "detail": {
          "field": "Resource_Type"
        },
        "tooltip": [
          {"field": "Water year", "type": "nominal", "title": "Year"},
          {"field": "Resource_Type", "type": "nominal", "title": "Source Fracture"},
          {"field": "Volume_ML", "type": "quantitative", "title": "Volume (ML)", "format": ","}
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
