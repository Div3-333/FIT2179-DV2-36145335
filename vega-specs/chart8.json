{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1000,
  "height": 140,
  "padding": {"left": 20, "top": 10, "right": 20, "bottom": 20},
  "title": {
    "text": "The Fluid Shift",
    "subtitle": "Supply Proportion HUD (ML) | 2015 - 2023",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 24,
    "subtitleFontSize": 13,
    "subtitleColor": "#B0BEC5",
    "offset": 20
  },
  "data": {
    "url": "data/final/chart8_liquid_data.csv"
  },
  "params": [
    {
      "name": "timeStep",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2015,
        "max": 2022,
        "step": 0.1,
        "name": "Analyze: "
      }
    }
  ],
  "transform": [
    {
      "filter": "abs(datum.YearStep - timeStep) < 0.05"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 80,
        "cornerRadius": 10,
        "stroke": "white",
        "strokeWidth": 2,
        "opacity": 0.9,
        "y": 60
      },
      "encoding": {
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "axis": null
        },
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": {
            "title": null,
            "labelColor": "white",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 5,
            "offset": 40,
            "labelFontSize": 14,
            "symbolSize": 300
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "white",
        "y": 15
      },
      "encoding": {
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "band": 0.5
        },
        "text": {"field": "Volume_ML", "type": "quantitative", "format": ",.2s"},
        "detail": {"field": "Resource_Type"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 90,
        "fontWeight": 900,
        "color": "rgba(255,255,255,0.08)",
        "y": 60
      },
      "encoding": {
        "text": {"field": "DisplayYear", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
