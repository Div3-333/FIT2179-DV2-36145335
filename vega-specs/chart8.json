{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 300,
  "height": 550,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "The Extraction Core Sample",
    "subtitle": "Interactive Depth Probe: Hover to Sample Water Source Proportions",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 24,
    "subtitleFontSize": 14,
    "subtitleColor": "#B0BEC5",
    "offset": 20
  },
  "data": {
    "url": "data/final/chart8_total-use-by-resource-figure.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(substring(datum['Water year'], 0, 4))",
      "as": "YearVal"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": ["YearVal"],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "area",
        "orient": "horizontal",
        "interpolate": "monotone",
        "cursor": "crosshair"
      },
      "encoding": {
        "y": {
          "field": "YearVal",
          "type": "quantitative",
          "title": "Depth of Time (Years)",
          "scale": {"reverse": true, "domain": [2015, 2022.5]},
          "axis": {
            "format": "d",
            "domainColor": "#B0BEC5",
            "labelColor": "#D7CCC8",
            "titleColor": "#D7CCC8",
            "grid": false,
            "tickCount": 8
          }
        },
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "axis": null
        },
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": {
            "orient": "right",
            "title": "Strata (Resource)",
            "labelColor": "#D7CCC8",
            "titleColor": "#D7CCC8"
          }
        },
        "opacity": {
          "condition": {"param": "hover", "value": 1, "empty": true},
          "value": 0.4
        }
      }
    },
    {
      "transform": [{"filter": {"param": "hover"}}],
      "mark": {
        "type": "rule",
        "color": "white",
        "strokeWidth": 2,
        "strokeDash": [4, 4]
      },
      "encoding": {
        "y": {"field": "YearVal", "type": "quantitative"}
      }
    },
    {
      "transform": [{"filter": {"param": "hover"}}],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -15,
        "fontSize": 16,
        "fontWeight": "bold",
        "color": "#FCFDBF"
      },
      "encoding": {
        "y": {"field": "YearVal", "type": "quantitative"},
        "x": {"datum": 0},
        "text": {"field": "Water year", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
