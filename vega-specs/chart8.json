{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 130,
  "padding": {"left": 10, "top": 10, "right": 10, "bottom": 10},
  "title": {
    "text": "The Fluid Shift",
    "subtitle": "Supply Proportion HUD (ML) | 2015 - 2023",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 24,
    "subtitleFontSize": 12,
    "subtitleColor": "#B0BEC5",
    "offset": 20
  },
  "data": {
    "url": "data/final/chart8_liquid_data.csv"
  },
  "params": [
    {
      "name": "timeStep",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2015,
        "max": 2022,
        "step": 0.1,
        "name": "Analyze: "
      }
    }
  ],
  "transform": [
    {
      "filter": "abs(datum.YearStep - timeStep) < 0.01"
    },
    {
      "calculate": "datum.Resource_Type == 'Surface water - consumptive' ? 20 : datum.Resource_Type == 'Surface water - environmental' ? 220 : datum.Resource_Type == 'Groundwater - consumptive' ? 420 : datum.Resource_Type == 'Recycled water - consumptive' ? 620 : 820",
      "as": "hudX"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 80,
        "cornerRadius": 8,
        "stroke": "white",
        "strokeWidth": 1.5,
        "opacity": 0.95
      },
      "encoding": {
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "axis": null
        },
        "y": {"datum": 50, "type": "quantitative", "scale": {"domain": [0, 100]}, "axis": null},
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": {
            "title": null,
            "labelColor": "white",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 5,
            "offset": 20,
            "labelFontSize": 14,
            "symbolSize": 300
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontSize": 14,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "hudX", 
          "type": "quantitative", 
          "scale": {"domain": [0, 1000]},
          "axis": null
        },
        "y": {"datum": 95, "type": "quantitative"},
        "text": {"field": "Volume_ML", "type": "quantitative", "format": ",.2s"},
        "color": {
          "field": "Resource_Type", 
          "type": "nominal",
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 90,
        "fontWeight": 900,
        "color": "rgba(255,255,255,0.08)"
      },
      "encoding": {
        "text": {"field": "DisplayYear", "type": "nominal"},
        "y": {"datum": 50, "type": "quantitative"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
