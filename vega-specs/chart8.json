{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 900,
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "The Extraction Core Sample",
    "subtitle": "Interactive Resource Proportions (100% Stacked) | 2015 - 2023",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 25
  },
  "data": {
    "url": "data/final/chart8_total-use-by-resource-figure.csv"
  },
  "layer": [
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "encodings": ["x"],
            "on": "mouseover",
            "clear": "mouseout",
            "nearest": true
          }
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "Water year",
          "type": "nominal",
          "title": "Timeline",
          "axis": {
            "labelColor": "#D7CCC8",
            "titleColor": "#D7CCC8",
            "grid": false,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "title": "Supply Proportion (%)",
          "axis": {
            "format": "%",
            "labelColor": "#D7CCC8",
            "titleColor": "#D7CCC8",
            "grid": false
          }
        },
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": {
            "title": "Water Source",
            "labelColor": "#D7CCC8",
            "titleColor": "#D7CCC8",
            "orient": "right",
            "offset": 20
          }
        },
        "opacity": {
          "condition": {"param": "hover", "value": 1, "empty": false},
          "value": 0.4
        }
      }
    },
    {
      "transform": [{"filter": {"param": "hover"}}],
      "mark": {
        "type": "rule",
        "color": "white",
        "strokeWidth": 2,
        "strokeDash": [4, 4]
      },
      "encoding": {
        "x": {"field": "Water year", "type": "nominal"}
      }
    },
    {
      "transform": [{"filter": {"param": "hover"}}],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -10,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "x": {"field": "Water year", "type": "nominal"},
        "y": {"datum": 1},
        "text": {"field": "Water year", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
