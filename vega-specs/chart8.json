{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 100,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "padding": {"left": 0, "top": 5, "right": 0, "bottom": 35},
  "title": {
    "text": "The Fluid Shift",
    "subtitle": "Resource Proportion HUD (ML) | 2015 - 2023",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 24,
    "subtitleFontSize": 12,
    "subtitleColor": "#B0BEC5",
    "offset": 10
  },
  "data": {
    "url": "data/final/chart8_liquid_data.csv"
  },
  "params": [
    {
      "name": "timeStep",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2015,
        "max": 2022,
        "step": 0.1,
        "name": "Analyze Depth: "
      }
    }
  ],
  "transform": [
    {
      "filter": "abs(datum.YearStep - timeStep) < 0.05"
    },
    {
      "calculate": "datum.Resource_Type == 'Surface water - consumptive' ? 10 : datum.Resource_Type == 'Surface water - environmental' ? 220 : datum.Resource_Type == 'Groundwater - consumptive' ? 450 : datum.Resource_Type == 'Recycled water - consumptive' ? 650 : 850",
      "as": "xPosHUD"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 60,
        "cornerRadius": 10,
        "stroke": "white",
        "strokeWidth": 1.5,
        "opacity": 0.95
      },
      "encoding": {
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "axis": null
        },
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": {
            "title": null,
            "labelColor": "white",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 5,
            "offset": 30,
            "labelFontSize": 14,
            "symbolSize": 200
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontSize": 13,
        "fontWeight": "bold",
        "dy": -40
      },
      "encoding": {
        "x": {
          "field": "xPosHUD", 
          "type": "quantitative", 
          "scale": {"domain": [0, 1000]},
          "axis": null
        },
        "text": {"field": "Volume_ML", "type": "quantitative", "format": ",.2s"},
        "color": {
          "field": "Resource_Type", 
          "type": "nominal",
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 90,
        "fontWeight": 900,
        "color": "rgba(255,255,255,0.08)",
        "dy": 0
      },
      "encoding": {
        "text": {"field": "DisplayYear", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
