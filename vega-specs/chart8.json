{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A dynamic morphing gauge showing proportional water supply shift.",
  "width": 400,
  "height": 550,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "The Fluid Shift",
    "subtitle": "Proportional 'Core Sample' of Victoria's Supply | 2015 - 2023",
    "anchor": "middle",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 30
  },
  "data": {
    "url": "data/final/chart8_total-use-by-resource-figure.csv"
  },
  "params": [
    {
      "name": "yearSlider",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2015,
        "max": 2022,
        "step": 1,
        "name": "Drill Depth (Year): "
      }
    }
  ],
  "transform": [
    {
      "calculate": "toNumber(substring(datum['Water year'], 0, 4))",
      "as": "YearVal"
    },
    {
      "filter": "datum.YearVal == yearSlider"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "width": 180,
        "cornerRadius": 10,
        "stroke": "white",
        "strokeWidth": 2,
        "opacity": 0.9
      },
      "encoding": {
        "y": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "title": null,
          "axis": null
        },
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": {
            "title": "Water Source",
            "labelColor": "#D7CCC8",
            "titleColor": "#D7CCC8",
            "orient": "right",
            "offset": 40
          }
        },
        "tooltip": [
          {"field": "Water year", "type": "nominal", "title": "Fiscal Year"},
          {"field": "Resource_Type", "type": "nominal", "title": "Source"},
          {"field": "Volume_ML", "type": "quantitative", "title": "Volume (ML)", "format": ","}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 100,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "y": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "band": 0.5
        },
        "text": {
          "field": "Volume_ML", 
          "type": "quantitative", 
          "format": ",.2s"
        },
        "detail": {"field": "Resource_Type"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 40,
        "fontWeight": 900,
        "color": "rgba(255,255,255,0.1)",
        "y": 275
      },
      "encoding": {
        "text": {"field": "Water year", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
