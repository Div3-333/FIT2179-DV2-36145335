{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 220,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "padding": {"left": 0, "top": 20, "right": 0, "bottom": 120},
  "title": {
    "text": "The Fluid Shift",
    "subtitle": "Continuous 'Core Sample' of Victorian Supply Proportions | 2015 - 2023",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 30
  },
  "data": {
    "url": "data/final/chart8_liquid_data.csv"
  },
  "params": [
    {
      "name": "timeStep",
      "value": 2015,
      "bind": {
        "input": "range",
        "min": 2015,
        "max": 2022,
        "step": 0.1,
        "name": "Flow Timeline: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.YearStep == timeStep"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 180,
        "cornerRadius": 10,
        "stroke": "white",
        "strokeWidth": 2,
        "opacity": 0.95
      },
      "encoding": {
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "title": null,
          "axis": null
        },
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": {
            "title": null,
            "labelColor": "#D7CCC8",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 5,
            "offset": 60,
            "labelFontSize": 11
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 120,
        "fontWeight": 900,
        "color": "rgba(255,255,255,0.06)",
        "y": 100
      },
      "encoding": {
        "text": {"field": "DisplayYear", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
