{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "The Extraction Core Sample",
    "subtitle": "Select a year to probe the precise extraction volumes (ML) across all strata",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 25
  },
  "data": {
    "url": "data/final/chart8_total-use-by-resource-figure.csv"
  },
  "params": [
    {
      "name": "sampleYear",
      "value": "2019-20",
      "bind": {
        "input": "select",
        "options": [
          "2015-16",
          "2016-17",
          "2017-18",
          "2018-19",
          "2019-20",
          "2020-21",
          "2021-22",
          "2022-23"
        ],
        "name": "Forensic Year: "
      }
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "Water year",
          "type": "nominal",
          "title": "Timeline",
          "axis": {
            "labelColor": "#D7CCC8",
            "titleColor": "#D7CCC8",
            "grid": false,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "title": "Supply Proportion (%)",
          "axis": {
            "format": "%",
            "labelColor": "#D7CCC8",
            "titleColor": "#D7CCC8",
            "grid": false
          }
        },
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": {
            "title": "Water Source",
            "labelColor": "#D7CCC8",
            "titleColor": "#D7CCC8",
            "orient": "right",
            "offset": 20
          }
        },
        "opacity": {
          "condition": {"test": "datum['Water year'] == sampleYear", "value": 1},
          "value": 0.15
        }
      }
    },
    {
      "transform": [{"filter": "datum['Water year'] == sampleYear"}],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "x": {"field": "Water year", "type": "nominal"},
        "y": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "band": 0.5
        },
        "text": {"field": "Volume_ML", "type": "quantitative", "format": ",.0s"}
      }
    },
    {
      "transform": [{"filter": "datum['Water year'] == sampleYear"}],
      "mark": {
        "type": "rule",
        "color": "white",
        "strokeWidth": 2,
        "strokeDash": [4, 4]
      },
      "encoding": {
        "x": {"field": "Water year", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
