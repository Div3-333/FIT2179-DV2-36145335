{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "H-Sync Forensic Dashboard for Water Supply",
  "background": "transparent",
  "spacing": 40,
  "params": [
    {
      "name": "timeStep",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2015,
        "max": 2022,
        "step": 0.1,
        "name": "Analyze Year: "
      }
    }
  ],
  "hconcat": [
    {
      "width": 750,
      "height": 100,
      "title": {
        "text": "Proportional Shift",
        "fontSize": 18,
        "color": "#D7CCC8",
        "anchor": "start",
        "offset": 10
      },
      "data": {"url": "data/final/chart8_liquid_data.csv"},
      "transform": [{"filter": "abs(datum.YearStep - timeStep) < 0.05"}],
      "layer": [
        {
          "mark": {
            "type": "bar",
            "height": 80,
            "cornerRadius": 10,
            "stroke": "white",
            "strokeWidth": 1.5,
            "opacity": 0.9
          },
          "encoding": {
            "x": {
              "field": "Volume_ML",
              "type": "quantitative",
              "stack": "normalize",
              "axis": null
            },
            "color": {
              "field": "Resource_Type",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Surface water - consumptive",
                  "Surface water - environmental",
                  "Groundwater - consumptive",
                  "Recycled water - consumptive",
                  "Desalinated water - consumptive"
                ],
                "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
              },
              "legend": {
                "title": null,
                "labelColor": "white",
                "orient": "bottom",
                "direction": "horizontal",
                "columns": 5,
                "offset": 30,
                "labelFontSize": 12,
                "symbolSize": 150
              }
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "fontSize": 80,
            "fontWeight": 900,
            "color": "rgba(255,255,255,0.06)"
          },
          "encoding": {
            "text": {"field": "DisplayYear", "type": "nominal"}
          }
        }
      ]
    },
    {
      "width": 250,
      "height": 100,
      "title": {
        "text": "Forensic Amount (ML)",
        "fontSize": 14,
        "color": "#94C1EA",
        "anchor": "start",
        "fontStyle": "italic",
        "offset": 10
      },
      "data": {"url": "data/final/chart8_liquid_data.csv"},
      "transform": [
        {"filter": "abs(datum.YearStep - timeStep) < 0.05"},
        {"calculate": "datum.Resource_Type == 'Surface water - consumptive' ? 0 : datum.Resource_Type == 'Surface water - environmental' ? 1 : datum.Resource_Type == 'Groundwater - consumptive' ? 2 : datum.Resource_Type == 'Recycled water - consumptive' ? 3 : 4", "as": "rowOrder"}
      ],
      "mark": {"type": "text", "align": "right", "fontSize": 14, "fontWeight": "900"},
      "encoding": {
        "y": {"field": "rowOrder", "type": "ordinal", "axis": null},
        "text": {"field": "Volume_ML", "type": "quantitative", "format": ",.0f"},
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
