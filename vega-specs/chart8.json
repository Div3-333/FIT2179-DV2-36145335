{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1100,
  "height": 180,
  "padding": {"left": 10, "top": 10, "right": 10, "bottom": 10},
  "title": {
    "text": "The Fluid Shift",
    "subtitle": "Supply Proportion Forensic Dashboard | 2015 - 2023",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 24,
    "subtitleFontSize": 13,
    "subtitleColor": "#B0BEC5",
    "offset": 20
  },
  "data": {
    "url": "data/final/chart8_liquid_data.csv"
  },
  "params": [
    {
      "name": "timeStep",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2015,
        "max": 2022,
        "step": 0.1,
        "name": "Analyze Depth: "
      }
    }
  ],
  "transform": [
    {
      "filter": "abs(datum.YearStep - timeStep) < 0.05"
    },
    {
      "calculate": "datum.Resource_Type == 'Surface water - consumptive' ? 30 : datum.Resource_Type == 'Surface water - environmental' ? 55 : datum.Resource_Type == 'Groundwater - consumptive' ? 80 : datum.Resource_Type == 'Recycled water - consumptive' ? 105 : 130",
      "as": "rowY"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 120,
        "cornerRadius": 10,
        "stroke": "white",
        "strokeWidth": 1.5,
        "opacity": 0.9,
        "y": 80
      },
      "encoding": {
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "scale": {"domain": [0, 1.45]},
          "axis": null
        },
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": {
            "title": null,
            "labelColor": "white",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 5,
            "offset": 40,
            "labelFontSize": 14,
            "symbolSize": 300
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#D7CCC8"
      },
      "encoding": {
        "x": {"datum": 820, "type": "quantitative"},
        "y": {"field": "rowY", "type": "quantitative"},
        "text": {"field": "Resource_Type", "type": "nominal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": "900",
        "color": "white"
      },
      "encoding": {
        "x": {"datum": 1100, "type": "quantitative"},
        "y": {"field": "rowY", "type": "quantitative"},
        "text": {"field": "Volume_ML", "type": "quantitative", "format": ",.0f"},
        "color": {"field": "Resource_Type", "type": "nominal", "legend": null}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#94C1EA",
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {"datum": 820, "type": "quantitative"},
        "y": {"datum": 5, "type": "quantitative"},
        "text": {"datum": "Resource Stratum"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#94C1EA",
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {"datum": 1100, "type": "quantitative"},
        "y": {"datum": 5, "type": "quantitative"},
        "text": {"datum": "Amount (ML)"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 90,
        "fontWeight": 900,
        "color": "rgba(255,255,255,0.08)",
        "y": 80
      },
      "encoding": {
        "x": {"datum": 380, "type": "quantitative"},
        "text": {"field": "DisplayYear", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
