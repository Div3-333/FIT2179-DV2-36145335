{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "H-Sync Technical Dashboard with High-Emphasis Chromatic Shift.",
  "background": "transparent",
  "spacing": 50,
  "data": {"url": "data/final/chart8_liquid_data.csv"},
  "params": [
    {
      "name": "showModern",
      "value": false
    },
    {
      "name": "timeStep",
      "value": 2015,
      "bind": {
        "input": "range",
        "min": 2015,
        "max": 2025,
        "step": 0.1,
        "name": "Analyze Year: "
      }
    }
  ],
  "title": {
    "text": "The Proportional Pivot",
    "subtitle": "Supply Proportion Technical Dashboard (ML) | 2012 - 2025",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 30
  },
  "transform": [
    {"filter": "showModern || datum.YearStep <= 2021"},
    {"filter": "abs(datum.YearStep - timeStep) < 0.01"}
  ],
  "hconcat": [
    {
      "width": 850,
      "height": 100,
      "layer": [
        {
          "mark": {
            "type": "bar",
            "height": 80,
            "cornerRadius": 10,
            "stroke": "white",
            "strokeWidth": 1.5,
            "opacity": 0.9
          },
          "encoding": {
            "x": {
              "field": "Volume_ML",
              "type": "quantitative",
              "stack": "normalize",
              "axis": null
            },
            "color": {
              "field": "Resource_Type",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Desalinated water - consumptive",
                  "Recycled water - consumptive",
                  "Groundwater - consumptive",
                  "Surface water - environmental",
                  "Surface water - consumptive"
                ],
                "range": ["#F1C40F", "#A569BD", "#BB8FCE", "#2E86C1", "#3498DB"]
              },
              "legend": {
                "title": null,
                "labelColor": "white",
                "orient": "bottom",
                "direction": "horizontal",
                "columns": 5,
                "offset": 30,
                "labelFontSize": 12,
                "symbolSize": 150
              }
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "fontSize": 80,
            "fontWeight": 900
          },
          "encoding": {
            "text": {"field": "DisplayYear", "type": "nominal"},
            "color": {
              "condition": {"test": "timeStep > 2018", "value": "rgba(241, 196, 15, 0.1)"},
              "value": "rgba(52, 152, 219, 0.06)"
            }
          }
        }
      ]
    },
    {
      "width": 200,
      "height": 100,
      "title": {
        "text": "Technical Amount (ML)",
        "fontSize": 14,
        "color": "#94C1EA",
        "anchor": "start",
        "fontStyle": "italic",
        "offset": 10
      },
      "transform": [
        {"calculate": "datum.Resource_Type == 'Desalinated water - consumptive' ? 0 : datum.Resource_Type == 'Recycled water - consumptive' ? 1 : datum.Resource_Type == 'Groundwater - consumptive' ? 2 : datum.Resource_Type == 'Surface water - environmental' ? 3 : 4", "as": "rowOrder"}
      ],
      "mark": {"type": "text", "align": "right", "fontSize": 14, "fontWeight": "900"},
      "encoding": {
        "y": {"field": "rowOrder", "type": "ordinal", "axis": null},
        "text": {"field": "Volume_ML", "type": "quantitative", "format": ",.0f"},
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Desalinated water - consumptive",
              "Recycled water - consumptive",
              "Groundwater - consumptive",
              "Surface water - environmental",
              "Surface water - consumptive"
            ],
            "range": ["#F1C40F", "#A569BD", "#BB8FCE", "#2E86C1", "#3498DB"]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
