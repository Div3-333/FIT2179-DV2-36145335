{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 80,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "padding": {"left": 10, "top": 40, "right": 10, "bottom": 50},
  "title": {
    "text": "The Fluid Shift",
    "subtitle": "Resource Proportions (ML) | 2015 - 2023",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 22,
    "subtitleFontSize": 12,
    "subtitleColor": "#B0BEC5",
    "offset": 30
  },
  "data": {
    "url": "data/final/chart8_liquid_data.csv"
  },
  "params": [
    {
      "name": "timeStep",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2015,
        "max": 2022,
        "step": 0.1,
        "name": "Depth: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.YearStep == timeStep"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 70,
        "cornerRadius": 6,
        "stroke": "white",
        "strokeWidth": 1.5,
        "opacity": 0.9,
        "y": 10
      },
      "encoding": {
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "title": null,
          "axis": null
        },
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Surface water - consumptive",
              "Surface water - environmental",
              "Groundwater - consumptive",
              "Recycled water - consumptive",
              "Desalinated water - consumptive"
            ],
            "range": ["#3498DB", "#2E86C1", "#BB8FCE", "#A569BD", "#F1C40F"]
          },
          "legend": {
            "title": null,
            "labelColor": "white",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 5,
            "offset": 30,
            "labelFontSize": 10,
            "symbolSize": 80
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#E0F2FE",
        "dy": -10
      },
      "encoding": {
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "band": 0.5
        },
        "y": {"datum": 10},
        "text": {
          "field": "Volume_ML", 
          "type": "quantitative", 
          "format": ",.2s"
        },
        "detail": {"field": "Resource_Type"},
        "opacity": {
          "condition": {"test": "datum.Volume_ML > 100000", "value": 1},
          "value": 0
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "white",
        "strokeWidth": 1,
        "opacity": 0.4
      },
      "encoding": {
        "x": {
          "field": "Volume_ML",
          "type": "quantitative",
          "stack": "normalize",
          "band": 0.5
        },
        "y": {"datum": 10},
        "y2": {"datum": 25}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 80,
        "fontWeight": 900,
        "color": "rgba(255,255,255,0.06)",
        "y": 45
      },
      "encoding": {
        "text": {"field": "DisplayYear", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "font": "Source Sans Pro"
  }
}
