{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "H-Sync Technical Dashboard with High-Emphasis Chromatic Shift.",
  "background": "transparent",
  "spacing": 50,
  "params": [
    {
      "name": "showModern",
      "value": false
    },
    {
      "name": "timeStep",
      "value": 2020,
      "bind": {
        "input": "range",
        "min": 2015,
        "max": 2025,
        "step": 0.1,
        "name": "Analyze Year: "
      }
    }
  ],
  "title": {
    "text": "The Proportional Pivot",
    "subtitle": "Supply Proportion Technical Dashboard (ML) | 2012 - 2025",
    "anchor": "start",
    "color": "#D7CCC8",
    "fontSize": 28,
    "subtitleFontSize": 16,
    "subtitleColor": "#B0BEC5",
    "offset": 30
  },
  "hconcat": [
    {
      "width": 850,
      "height": 150,
      "layer": [
        {
          "mark": {
            "type": "bar",
            "height": 80,
            "cornerRadius": 10,
            "stroke": "white",
            "strokeWidth": 1.5,
            "opacity": 0.9
          },
          "encoding": {
            "x": {
              "field": "Volume_ML",
              "type": "quantitative",
              "stack": "normalize",
              "axis": null
            },
            "color": {
              "field": "Resource_Type",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Desalinated water - consumptive",
                  "Recycled water - consumptive",
                  "Groundwater - consumptive",
                  "Surface water - environmental",
                  "Surface water - consumptive"
                ],
                "range": [
                  "#F1C40F",
                  "#A569BD",
                  "#BB8FCE",
                  "#2E86C1",
                  "#3498DB"
                ]
              },
              "legend": {
                "title": null,
                "labelColor": "white",
                "orient": "bottom",
                "direction": "horizontal",
                "columns": 5,
                "offset": 30,
                "labelFontSize": 12,
                "symbolSize": 150
              }
            }
          },
          "data": {
            "url": "data/final/chart8_liquid_data.csv"
          },
          "transform": [
            {
              "filter": "showModern || datum.YearStep <= 2021"
            },
            {
              "filter": "abs(datum.YearStep - timeStep) < 0.01"
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "fontSize": 64,
            "fontWeight": 900
          },
          "encoding": {
            "text": {
              "field": "DisplayYear",
              "type": "nominal"
            },
            "color": {
              "condition": {
                "test": "timeStep > 2018",
                  "value": "rgba(241, 196, 15, 0.07)"
              },
              "value": "rgba(52, 152, 219, 0.05)"
            }
          },
          "data": {
            "url": "data/final/chart8_liquid_data.csv"
          },
          "transform": [
            {
              "filter": "showModern || datum.YearStep <= 2021"
            },
            {
              "filter": "abs(datum.YearStep - timeStep) < 0.01"
            }
          ]
        },
        {
          "data": {
            "values": [
              {
                "x1": 0.7,
                "x2": 0.45
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#FCFDBF",
            "strokeWidth": 2,
            "opacity": 0.9,
            "clip": false
          },
          "encoding": {
            "x": {
              "field": "x1",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1
                ]
              },
              "axis": null
            },
            "x2": {
              "field": "x2"
            },
            "y": {
              "value": 75
            },
            "y2": {
              "value": 30
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "x": 0.42,
                "text": "2020 alternatives|about 12.4%"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#FCFDBF",
            "lineBreak": "|",
            "clip": false
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1
                ]
              },
              "axis": null
            },
            "y": {
              "value": 4
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    },
    {
      "width": 200,
      "height": 100,
      "title": {
        "text": "Technical Amount (ML)",
        "fontSize": 14,
        "color": "#94C1EA",
        "anchor": "start",
        "fontStyle": "italic",
        "offset": 10
      },
      "transform": [
        {
          "filter": "showModern || datum.YearStep <= 2021"
        },
        {
          "filter": "abs(datum.YearStep - timeStep) < 0.01"
        },
        {
          "calculate": "datum.Resource_Type == 'Desalinated water - consumptive' ? 0 : datum.Resource_Type == 'Recycled water - consumptive' ? 1 : datum.Resource_Type == 'Groundwater - consumptive' ? 2 : datum.Resource_Type == 'Surface water - environmental' ? 3 : 4",
          "as": "rowOrder"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 14,
        "fontWeight": "900"
      },
      "encoding": {
        "y": {
          "field": "rowOrder",
          "type": "ordinal",
          "axis": null
        },
        "text": {
          "field": "Volume_ML",
          "type": "quantitative",
          "format": ",.0f"
        },
        "color": {
          "field": "Resource_Type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Desalinated water - consumptive",
              "Recycled water - consumptive",
              "Groundwater - consumptive",
              "Surface water - environmental",
              "Surface water - consumptive"
            ],
            "range": [
              "#F1C40F",
              "#A569BD",
              "#BB8FCE",
              "#2E86C1",
              "#3498DB"
            ]
          },
          "legend": null
        }
      },
      "data": {
        "url": "data/final/chart8_liquid_data.csv"
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "font": "Source Sans Pro"
  }
}
